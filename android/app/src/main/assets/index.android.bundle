15\u0948\u0930\u093f\u092f\u0930 \u091c\u093e\u0917\u0930\u0942\u0915\u0924\u093e",FUN:"\u092e\u091c\u093c\u093e",EFFECTIVE_COMMUNICATION:"\u092a\u094d\u0930\u092d\u093e\u0935\u0940 \u0938\u0902\u091a\u093e\u0930",q6_login_cred:"\u0905\u0902\u0924 \u092e\u0947\u0902, \u091a\u0932\u093f\u090f \u0906\u092a\u0915\u0947 \u0932\u0949\u0917\u093f\u0928 \u0915\u094d\u0930\u0947\u0921\u0947\u0902\u0936\u093f\u092f\u0932\u094d\u0938 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902",lb_username:"\u0905\u092a\u0928\u093e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0947\u0902",lb_username_info:"\u092f\u0939 \u0932\u0949\u0917\u093f\u0928 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e",lb_username_error:"\u0909\u0938 \u0928\u093e\u092e \u0915\u093e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u092e\u094c\u091c\u0942\u0926 \u0939\u0948",lb_pass:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921",confirm_password:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902",customize_dashboard_message:"\u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0915\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",login:"\u0932\u0949\u0917\u093f\u0928",content:"\u0935\u093f\u0937\u092f-\u0935\u0938\u094d\u0924\u0941",courses:"\u092a\u093e\u0920\u094d\u092f\u0915\u094d\u0930\u092e",profile:"\u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932",usersname:"\u0905\u092a\u0928\u0947 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e \u0915\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0947\u0902",username:"\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e",password:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921",forgot_password:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092d\u0942\u0932 \u0917\u092f\u093e",remember_me:"\u092e\u0941\u091d\u0947 \u092f\u093e\u0926 \u0930\u0916\u093f\u090f\u0964",is_required:"\u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948",min:"\u0928\u094d\u092f\u0942\u0928\u0924\u092e",max:"\u0905\u0927\u093f\u0915\u0924\u092e",characters:"\u0935\u0930\u094d\u0923",Password_must_match:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u094b \u092e\u0947\u0932 \u0916\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f",can_only_contain_letters:"\u0915\u0947\u0935\u0932 \u0905\u0915\u094d\u0937\u0930\u094b\u0902 \u0915\u094b \u0936\u093e\u092e\u093f\u0932 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902",Choose_at_least:"\u0915\u092e \u0938\u0947 \u0915\u092e \u091a\u0941\u0928\u0947\u0902",cards_can_be_selected:"\u0915\u093e\u0930\u094d\u0921 \u0915\u093e \u091a\u092f\u0928 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948",terms_and_conditions:"\u0905\u0902\u0924 \u092e\u0947\u0902, \u090f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0914\u0930 \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0905\u0928\u0941\u092d\u0935 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0915\u0943\u092a\u092f\u093e \u0939\u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u0909\u092e\u094d\u0930 \u092c\u0924\u093e\u090f\u0902\u0964 \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0939\u092e\u0947\u0902 \u0909\u092a\u092f\u0941\u0915\u094d\u0924 \u0928\u093f\u092f\u092e \u0914\u0930 \u0936\u0930\u094d\u0924\u0947\u0902 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0947\u0917\u0940\u0964",I_am_18_or_older:"\u092e\u0948\u0902 18 \u092f\u093e \u0909\u0938\u0938\u0947 \u0905\u0927\u093f\u0915 \u0909\u092e\u094d\u0930 \u0915\u093e \u0939\u0942\u0901",I_am_under_18:"\u092e\u0948\u0902 18 \u0938\u0947 \u0915\u092e \u0939\u0942\u0901","T&C":"\u0915\u0943\u092a\u092f\u093e \u0907\u0938\u0947 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u0940\u091a\u0947 \u0924\u0915 \u0938\u094d\u0915\u094d\u0930\u0949\u0932 \u0915\u0930\u0915\u0947 \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f \u0915\u094b \u092a\u0922\u093c\u0947\u0902\u0964",create_account:"\u0916\u093e\u0924\u093e \u092c\u0928\u093e\u090f\u0901",button:"\u092c\u091f\u0928","T&C_1":"\u092a\u094d\u0930\u0925\u092e \u090f\u091c\u0941\u0915\u0947\u0936\u0928 \u092b\u093e\u0909\u0902\u0921\u0947\u0936\u0928 (\u092a\u094d\u0930\u0925\u092e) \u092d\u093e\u0930\u0924 \u0915\u0947 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0947 \u0917\u0948\u0930 \u0938\u0930\u0915\u093e\u0930\u0940 \u0938\u0902\u0917\u0920\u0928\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0939\u0948, \u091c\u093f\u0938\u0915\u093e \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u092e\u0941\u0902\u092c\u0908 \u092a\u094d\u0930\u0925\u092e \u092e\u0947\u0902 \u0939\u0948, \u091c\u093f\u0938\u0928\u0947 25 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0935\u0930\u094d\u0937\u094b\u0902 \u0938\u0947 \u0936\u093f\u0915\u094d\u0937\u093e \u0915\u0947 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0915\u093e\u092e \u0915\u093f\u092f\u093e \u0939\u0948\u0964","T&C_2":"\u091c\u0948\u0938\u093e \u0915\u093f \u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902, \u0906\u092a \u092a\u094d\u0930\u0925\u092e \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u092d\u093e\u0917 \u0932\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938\u0915\u0947 \u0938\u0902\u0926\u0930\u094d\u092d \u092e\u0947\u0902, \u092a\u094d\u0930\u0925\u092e, \u0905\u092a\u0928\u0947 \u0938\u094d\u0935\u092f\u0902\u0938\u0947\u0935\u0915\u094b\u0902/\u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f\u092f\u094b\u0902 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947, \u0906\u092a\u0915\u093e \u0921\u0947\u091f\u093e \u090f\u0915\u0924\u094d\u0930 \u0915\u0930\u0947\u0917\u093e \u091c\u093f\u0938\u092e\u0947\u0902 \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u092d\u093e\u0917 \u0932\u0947\u0924\u0947 \u0938\u092e\u092f \u092c\u0941\u0928\u093f\u092f\u093e\u0926\u0940 \u092a\u0939\u091a\u093e\u0928, \u0938\u094d\u0925\u093e\u0928, \u0938\u0902\u092a\u0930\u094d\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940, \u0938\u0940\u0916\u0928\u0947 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0921\u0947\u091f\u093e, \u091a\u093f\u0924\u094d\u0930/\u0924\u0938\u094d\u0935\u0940\u0930\u0947\u0902, \u0935\u0940\u0921\u093f\u092f\u094b, \u0935\u0949\u092f\u0938 \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 ('\u0938\u093e\u092e\u0917\u094d\u0930\u0940') \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902 \u0932\u0947\u0915\u093f\u0928 \u0907\u0928\u094d\u0939\u0940\u0902 \u0924\u0915 \u0938\u0940\u092e\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964","T&C_3":"\u090f\u0915\u0924\u094d\u0930 \u0915\u0940 \u0917\u0908 \u091c\u093e\u0928\u0915\u093e\u0930\u0940/\u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0906\u0902\u0936\u093f\u0915 \u092f\u093e \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u0930\u0942\u092a \u0938\u0947 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0903","T&C_4":"1. \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e \u0915\u093e\u0930\u094d\u092f\u093e\u0928\u094d\u0935\u092f\u0928 \u0914\u0930 \u0938\u0941\u0927\u093e\u0930, \u0938\u093e\u092e\u0941\u0926\u093e\u092f\u093f\u0915 \u092d\u093e\u0917\u0940\u0926\u093e\u0930\u0940 \u0914\u0930 \u0930\u093f\u092a\u094b\u0930\u094d\u091f\u093f\u0902\u0917 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u0964","T&C_5":"2. \u092a\u094d\u0930\u0925\u092e \u0915\u0947 \u092a\u094d\u0930\u0915\u093e\u0936\u0928\u094b\u0902 \u092e\u0947\u0902, \u0926\u093e\u0924\u093e \u0930\u093f\u092a\u094b\u0930\u094d\u091f (\u092d\u093e\u0930\u0924 \u0915\u0947 \u0938\u093e\u0925-\u0938\u093e\u0925 \u0905\u0902\u0924\u0930\u094d\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u094d\u0924\u0930 \u092a\u0930), \u092e\u0940\u0921\u093f\u092f\u093e \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u093e\u0901, \u0938\u094b\u0936\u0932 \u092e\u0940\u0921\u093f\u092f\u093e \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u093e\u0901 (\u091c\u0948\u0938\u0947\u0964 : \u092b\u0947\u0938\u092c\u0941\u0915, \u092f\u0942\u091f\u094d\u092f\u0942\u092c, \u0907\u0902\u0938\u094d\u091f\u093e\u0917\u094d\u0930\u093e\u092e, \u0932\u093f\u0902\u0915\u094d\u0921\u0907\u0928, \u091f\u094d\u0935\u093f\u091f\u0930, \u0925\u094d\u0930\u0947\u0921\u094d\u0938 \u0906\u0926\u093f\u0964 ), \u0921\u093f\u091c\u093f\u091f\u0932 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u093e\u0901 (\u091c\u0948\u0938\u0947\u0964 : \u092a\u094d\u0930\u0925\u092e \u0915\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u0947\u0902)\u0964 \u0907\u0938\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0936\u0948\u0915\u094d\u0937\u093f\u0915 \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091c\u093e\u0917\u0930\u0942\u0915\u0924\u093e \u092a\u0948\u0926\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964","T&C_6":"3. \u092a\u094d\u0930\u0925\u092e \u0915\u0947 \u0927\u0930\u094d\u092e\u093e\u0930\u094d\u0925 \u0915\u093e\u0930\u094d\u092f\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091c\u093e\u0917\u0930\u0942\u0915\u0924\u093e \u092a\u0948\u0926\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0926\u093e\u0928\u0926\u093e\u0924\u093e\u0913\u0902 (\u092d\u093e\u0930\u0924 \u0915\u0947 \u0938\u093e\u0925-\u0938\u093e\u0925 \u0905\u0902\u0924\u0930\u094d\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u094d\u0924\u0930 \u092a\u0930) \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u093e\u0964","T&C_7":"\u0906\u092a\u0938\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0939\u0948 \u0915\u093f \u0906\u092a \u0909\u092a\u0930\u094d\u092f\u0941\u0915\u094d\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940/\u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u094b \u090f\u0915\u0924\u094d\u0930 \u0915\u0930\u0928\u0947, \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0915\u0930\u0928\u0947 \u0914\u0930 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0940 \u0938\u0939\u092e\u0924\u093f \u0926\u0947\u0902\u0964 \u0939\u093e\u0932\u093e\u0901\u0915\u093f, \u0905\u092a\u0928\u0947 \u0935\u093f\u0935\u0947\u0915 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930, \u0906\u092a \u0905\u092a\u0928\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940/\u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u090f\u0915\u0924\u094d\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0940 \u0938\u0939\u092e\u0924\u093f \u0938\u0947 \u0907\u0928\u0915\u093e\u0930 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","T&C_8":"\u092e\u0948\u0902 \u092a\u094d\u0930\u0925\u092e, \u0907\u0938\u0915\u0947 \u0938\u094d\u0935\u092f\u0902\u0938\u0947\u0935\u0915\u094b\u0902 \u0914\u0930/\u092f\u093e \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f\u092f\u094b\u0902 \u0915\u094b \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u091c\u092c\u0930\u0926\u0938\u094d\u0924\u0940 \u0915\u0947 \u092e\u0941\u091d\u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0909\u092a\u0930\u094d\u092f\u0941\u0915\u094d\u0924 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947, \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0915\u0930\u0928\u0947, \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u0947, \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0942\u0902\u0964","T&C_9":"\u092f\u0926\u093f \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u092f \u092e\u0948\u0902 \u0928\u093f\u0930\u094d\u0923\u092f \u0932\u0947\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u092e\u0947\u0930\u0947 \u0921\u0947\u091f\u093e/\u092b\u094b\u091f\u094b/\u0935\u0940\u0921\u093f\u092f\u094b \u0915\u094b \u092a\u094d\u0930\u0925\u092e \u0915\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092f\u093e \u092d\u0902\u0921\u093e\u0930\u0923 \u092a\u094d\u0932\u0947\u091f\u092b\u093e\u0930\u094d\u092e\u094b\u0902 \u0938\u0947 \u0939\u091f\u093e \u0926\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f, \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u092f\u093e \u0920\u0940\u0915 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f, \u0924\u094b \u092e\u0948\u0902 \u092a\u094d\u0930\u0925\u092e \u0915\u0947 \u0938\u094d\u0935\u092f\u0902\u0938\u0947\u0935\u0915/\u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f \u0915\u094b \u092b\u094b\u0928/\u0908\u092e\u0947\u0932 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0938\u0942\u091a\u093f\u0924 \u0915\u0930\u0942\u0902\u0917\u093e, \u091c\u093f\u0938\u0915\u0947 \u092c\u093e\u0926 \u0932\u093f\u0916\u093f\u0924 \u0935\u093e\u092a\u0938\u0940/\u0938\u0939\u092e\u0924\u093f \u0915\u093e \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926, \u092a\u094d\u0930\u0925\u092e, \u0907\u0938\u0915\u0947 \u0938\u094d\u0935\u092f\u0902\u0938\u0947\u0935\u0915 \u0914\u0930/\u092f\u093e \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f 15 \u0915\u093e\u0930\u094d\u092f \u0926\u093f\u0935\u0938\u094b\u0902 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0907\u0938\u0947 \u0939\u091f\u093e \u0926\u0947\u0902\u0917\u0947 \u092f\u093e \u0938\u0941\u0927\u093e\u0930\u0947\u0902\u0917\u0947/\u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0930\u0947\u0902\u0917\u0947\u0964 \u0907\u0938 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947\u0902 \u0938\u0902\u092a\u0930\u094d\u0915 \u0935\u093f\u0935\u0930\u0923 \u0928\u0940\u091a\u0947 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964","T&C_10":"\u092e\u0948\u0902\u0928\u0947 \u092a\u0942\u0930\u094d\u0935\u0917\u093e\u092e\u0940 \u0915\u094b \u092a\u0922\u093c\u093e \u0939\u0948 \u0914\u0930/\u092f\u093e \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0938\u092e\u091d\u093e\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0914\u0930 \u0907\u0938\u0915\u0947 \u0936\u092c\u094d\u0926\u094b\u0902 \u0915\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0938\u092e\u091d\u0924\u093e \u0939\u0942\u0902\u0964 \u0939\u092e \u090f\u0924\u0926\u094d\u0926\u094d\u0935\u093e\u0930\u093e \u0905\u092a\u0928\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940/\u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u0909\u092a\u0930\u094d\u092f\u0941\u0915\u094d\u0924 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0940 \u0938\u0939\u092e\u0924\u093f \u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0907\u0938 \u0924\u0930\u0939 \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947\u0902 \u0915\u094b\u0908 \u092d\u0940 \u0926\u093e\u0935\u093e \u0928\u0939\u0940\u0902 \u0915\u0930\u0947\u0902\u0917\u0947\u0964","T&C_11":"\u0938\u0902\u092a\u0930\u094d\u0915 \u0935\u093f\u0935\u0930\u0923\u0903 \u092a\u094d\u0930\u0925\u092e \u0936\u093f\u0915\u094d\u0937\u093e \u092a\u094d\u0930\u0924\u093f\u0937\u094d\u0920\u093e\u0928",office_adrress:"\u0926\u093f\u0932\u094d\u0932\u0940 \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f\u0903 B 4/59, \u0938\u092b\u0926\u0930\u091c\u0902\u0917 \u090f\u0928\u094d\u0915\u094d\u0932\u0947\u0935, \u0928\u0908 \u0926\u093f\u0932\u094d\u0932\u0940-110029",office_email:"\u0908\u092e\u0947\u0932\u0903:dataprotectionofficer@pratham.org",office_phone:"\u092b\u094b\u0928 \u0928\u0902\u092c: 011-26177200",office_website:"| www.pratham.org |",office_cin:"CIN: U80101MH2002NPL136300","T&C_12":"\u092e\u0948\u0902\u0928\u0947 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f \u0915\u094b \u092a\u0922\u093c\u093e \u0914\u0930 \u0909\u0938\u0938\u0947 \u0938\u0939\u092e\u0924 \u0939\u0942\u0902 \u0914\u0930 \u092e\u0948\u0902 \u0938\u0939\u092e\u0924\u093f \u092a\u094d\u0930\u092a\u0924\u094d\u0930 \u092e\u0947\u0902 \u0935\u0930\u094d\u0923\u093f\u0924 \u0905\u092a\u0928\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0921\u0947\u091f\u093e \u0915\u0947 \u0938\u0902\u0917\u094d\u0930\u0939 \u0914\u0930 \u0909\u092a\u092f\u094b\u0917 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0942\u0902\u0964","T&C_13":"\u0906\u092a \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092a\u0943\u0937\u094d\u0920 \u092e\u0947\u0902 '\u0921\u0947\u091f\u093e \u090f\u0902\u0921 \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u0938\u0940 \u0938\u0947\u0902\u091f\u0930' \u092e\u0947\u0902 \u0926\u093f\u090f \u0917\u090f \u0938\u0902\u092a\u0930\u094d\u0915 \u0935\u093f\u0935\u0930\u0923 \u0938\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u092f \u0921\u0947\u091f\u093e \u0939\u091f\u093e\u0928\u0947, \u0905\u0926\u094d\u092f\u0924\u0928 \u0915\u0930\u0928\u0947 \u092f\u093e \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0915\u0947 \u0932\u093f\u090f \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",username_already_exists:"\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e \u092a\u0939\u0932\u0947 \u0938\u0947 \u092e\u094c\u091c\u0942\u0926 \u0939\u0948",username_is_already_exists_in_keycloak:"\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e \u092a\u0939\u0932\u0947 \u0938\u0947 \u092e\u094c\u091c\u0942\u0926 \u0939\u0948",something_went_wrong_try_again_later:"\u0924\u0915\u0928\u0940\u0915\u0940 \u0924\u094d\u0930\u0941\u091f\u093f, \u0915\u0943\u092a\u092f\u093e \u092c\u093e\u0926 \u092e\u0947\u0902 \u092b\u093f\u0930 \u0938\u0947 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",Learning_Content:"\u0938\u0940\u0916\u0928\u0947 \u0915\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940",Update_your_preferences_to_get_the_best_picks_just_for_you:"\u0915\u0947\u0935\u0932 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u093e \u0935\u093f\u0915\u0932\u094d\u092a \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e\u0913\u0902 \u0915\u094b \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902!",Based_on_Your_Interests:"\u0906\u092a\u0915\u0940 \u0930\u0941\u091a\u093f\u092f\u094b\u0902 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930",view_all:"\u0938\u092c \u0926\u0947\u0916\u0947\u0902",Financial_Literacy:"\u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0938\u093e\u0915\u094d\u0937\u0930\u0924\u093e",Continue_Learning:"\u0938\u0940\u0916\u0928\u093e \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902",Preferences:"\u0935\u0930\u0940\u092f\u0924\u093e\u090f\u0901",Food_Production:"\u0916\u093e\u0926\u094d\u092f \u0909\u0924\u094d\u092a\u093e\u0926\u0928",Conceptual_Thinking:"\u0905\u0935\u0927\u093e\u0930\u0923\u093e\u0924\u094d\u092e\u0915 \u0938\u094b\u091a",Todays_Top_Pick:"\u0906\u091c \u0915\u093e \u0936\u0940\u0930\u094d\u0937 \u091a\u092f\u0928",Art:"\u0915\u0932\u093e",Assessments:"\u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928",assessment:"\u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928","pre-test":"\u092a\u094d\u0930\u0940 \u091f\u0947\u0938\u094d\u091f","post-test":"\u092a\u094b\u0938\u094d\u091f \u091f\u0947\u0938\u094d\u091f",Inprogress:"\u092a\u094d\u0930\u0917\u0924\u093f \u092e\u0947\u0902",Overallscore:"\u0938\u092e\u0917\u094d\u0930 \u0938\u094d\u0915\u094b\u0930:",completed:"\u092a\u0942\u0930\u093e \u0915\u093f\u092f\u093e",take_the_test:"\u091f\u0947\u0938\u094d\u091f \u0932\u0947\u0902\u0964",not_started:"\u0936\u0941\u0930\u0942 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0917\u092f\u093e",submitted_On:"\u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e :",reading:"\u092a\u0922\u093c\u0928\u093e\u0964",out_of:"\u092e\u0947\u0902 \u0938\u0947",correct_answers:"\u0938\u0939\u0940 \u091c\u0935\u093e\u092c",assessment_note:"\u0928\u094b\u091f\u0903 \u0906\u092a\u0915\u0947 \u092a\u0942\u0930\u094d\u0935-\u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u092a\u0930 \u0924\u092d\u0940 \u0935\u093f\u091a\u093e\u0930 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e \u091c\u092c \u0906\u092a \u0938\u092d\u0940 \u0935\u093f\u0937\u092f\u094b\u0902 \u0915\u094b \u092a\u0942\u0930\u093e \u0915\u0930\u0947\u0902\u0917\u0947\u0964",assessment_instructions:"\u0928\u0940\u091a\u0947 \u0926\u093f\u090f \u0917\u090f \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0935\u093f\u0937\u092f \u0915\u0947 \u0932\u093f\u090f \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u092a\u0942\u0930\u093e \u0915\u0930\u0947\u0902\u0964 \u0909\u0928\u094d\u0939\u0947\u0902 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0915\u094d\u0930\u092e \u092e\u0947\u0902 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0947\u0902\u0964",instruction1:"\u0905\u0935\u0927\u093f\u0903 \u092a\u0930\u0940\u0915\u094d\u0937\u093e \u0915\u093e \u0938\u092e\u092f \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0914\u0930 \u092f\u0939 20 \u092e\u093f\u0928\u091f \u0924\u0915 \u091a\u0932\u0947\u0917\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0947 \u0938\u092e\u092f \u0915\u094b \u0909\u0938\u0940 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0947\u0902\u0964",instruction2:"\u092a\u094d\u0930\u0936\u094d\u0928\u094b\u0902 \u0915\u0940 \u0938\u0902\u0916\u094d\u092f\u093e\u0903 \u092a\u0930\u0940\u0915\u094d\u0937\u093e \u092e\u0947\u0902 \u092c\u0939\u0941\u0935\u093f\u0915\u0932\u094d\u092a\u0940\u092f \u092a\u094d\u0930\u0936\u094d\u0928 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0906\u092a \u0926\u093f\u090f \u0917\u090f \u0938\u092e\u092f \u0938\u0940\u092e\u093e \u0915\u0947 \u092d\u0940\u0924\u0930 \u0938\u092d\u0940 \u092a\u094d\u0930\u0936\u094d\u0928\u094b\u0902 \u0915\u093e \u0909\u0924\u094d\u0924\u0930 \u0926\u0947\u0902\u0964",instruction3:"\u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924\u093f\u0915\u0930\u0923\u0903 \u0906\u092a \u0915\u0947\u0935\u0932 \u090f\u0915 \u092c\u093e\u0930 \u092a\u0930\u0940\u0915\u094d\u0937\u093e \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0906\u092a \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u0947 \u0909\u0924\u094d\u0924\u0930\u094b\u0902 \u0915\u0940 \u0938\u093e\u0935\u0927\u093e\u0928\u0940\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0928\u0947 \u0915\u093e \u0926\u0942\u0938\u0930\u093e \u0905\u0935\u0938\u0930 \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u093e\u0964",instruction4:"\u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u093e\u0903 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0906\u092a \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0930\u0941\u0915\u093e\u0935\u091f \u0915\u0947 \u090f\u0915 \u0936\u093e\u0902\u0924 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u092e\u0947\u0902 \u0939\u0948\u0902\u0964 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0906\u092a\u0915\u093e \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0938\u094d\u0925\u093f\u0930 \u0939\u0948\u0964",instruction5:"\u091f\u0947\u0938\u094d\u091f \u0915\u094b \u0928\u0947\u0935\u093f\u0917\u0947\u091f \u0915\u0930\u0928\u093e\u0903 \u0905\u092a\u0928\u0947 \u0909\u0924\u094d\u0924\u0930 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092a\u094d\u0930\u0936\u094d\u0928 \u0915\u094b \u0927\u094d\u092f\u093e\u0928 \u0938\u0947 \u092a\u0922\u093c\u0947\u0902\u0964 \u0906\u092a \u092a\u094d\u0930\u0936\u094d\u0928\u094b\u0902 \u0915\u094b \u091b\u094b\u0921\u093c \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u092a\u0921\u093c\u0928\u0947 \u092a\u0930 \u092c\u093e\u0926 \u092e\u0947\u0902 \u0909\u0928\u0915\u0947 \u092a\u093e\u0938 \u0932\u094c\u091f \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u091f\u093e\u0907\u092e\u0930 \u092a\u0930 \u0928\u091c\u093c\u0930 \u0930\u0916\u0947\u0902\u0964 \u092a\u094d\u0930\u0936\u094d\u0928\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0928\u0947\u0935\u093f\u0917\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u0917\u0932\u093e \u0914\u0930 \u092a\u093f\u091b\u0932\u093e \u092c\u091f\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964","Read_T_&_C":"\u092e\u0948\u0902\u0928\u0947 \u092a\u0922\u093c\u093e \u0939\u0948 \u0914\u0930 \u0938\u0939\u092e\u0924 \u0939\u0942\u0901",terms_and_conditions2:"\u0928\u093f\u092f\u092e \u0914\u0930 \u0936\u0930\u094d\u0924\u0947\u0902",no_data_found:"\u0915\u094b\u0908 \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e",my_profile:"\u092e\u0947\u0930\u093e \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932",second_chance_program:"\u0926\u0942\u0938\u0930\u093e \u092e\u094c\u0915\u093e \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e",pathways:"\u092e\u093e\u0930\u094d\u0917",logout:"\u0932\u0949\u0917\u0906\u0909\u091f \u0915\u0930\u0947\u0902",general_instructions:"\u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0928\u093f\u0930\u094d\u0926\u0947\u0936",test_medium:"\u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u092e\u093e\u0927\u094d\u092f\u092e",board:"\u092c\u094b\u0930\u094d\u0921",start_test:"\u091f\u0947\u093