\u093e\u0909\u0928\u0932\u094b\u0921 \u092a\u094d\u0930\u0917\u0924\u093f \u092a\u0930 \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u0906\u092a \u0935\u093e\u092a\u0938 \u091c\u093e\u0928\u093e \u0914\u0930 \u0907\u0938\u0947 \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?",is_invalid:"\u0905\u092e\u093e\u0928\u094d\u092f \u0939\u0948",prepare_for:"\u0924\u0948\u092f\u093e\u0930\u0940 \u0915\u0930\u0947\u0902",sessions:"\u0938\u0924\u094d\u0930",lets_get_started_dive_in:"\u091a\u0932\u093f\u090f \u0936\u0941\u0930\u0942 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0921\u0941\u092c\u0915\u0940 \u0932\u0917\u093e\u090f\u0902!",great_start_keep_going:"\u0936\u093e\u0928\u0926\u093e\u0930 \u0936\u0941\u0930\u0941\u0906\u0924, \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902!",mission_accomplished:"\u092e\u093f\u0936\u0928 \u092a\u0942\u0930\u093e \u0939\u0941\u0906!",previous_class_materials:"\u0938\u0924\u094d\u0930 \u0915\u0947 \u092c\u093e\u0926 \u0915\u093e \u0905\u0927\u094d\u092f\u092f\u0928",homework_and_practice:"\u0917\u0943\u0939\u0915\u093e\u0930\u094d\u092f \u0914\u0930 \u0905\u092d\u094d\u092f\u093e\u0938",post_requisites:"(\u092a\u094b\u0938\u094d\u091f-\u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e\u090f\u0901)",complete_activities_for_previous_classes:"\u092a\u093f\u091b\u0932\u0947 \u0938\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u093e\u0901 \u092a\u0942\u0930\u0940 \u0915\u0930\u0947\u0902",my_timetable:"\u092e\u0947\u0930\u093e \u0938\u092e\u092f \u0938\u093e\u0930\u0923\u0940",what_you_are_going_to_learn:"\u0906\u092a \u0915\u094d\u092f\u093e \u0938\u0940\u0916\u0928\u0947 \u091c\u093e \u0930\u0939\u0947 \u0939\u0948\u0902:",overall_attendance:"\u0915\u0941\u0932 \u0909\u092a\u0938\u094d\u0925\u093f\u0924\u093f",see_my_full_attendance:"\u092e\u0947\u0930\u0940 \u092a\u0942\u0930\u0940 \u0909\u092a\u0938\u094d\u0925\u093f\u092