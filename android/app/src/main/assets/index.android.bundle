0b2a\u0b41\u0b28\u0b03 \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964","Take a plain white paper":"\u0b0f\u0b15 \u0b38\u0b3e\u0b27\u0b3e \u0b27\u0b33\u0b3e \u0b15\u0b3e\u0b17\u0b1c \u0b28\u0b3f\u0b05\u0b28\u0b4d\u0b24\u0b41\u0964","Use pen with black or blue ink only":"\u0b15\u0b47\u0b2c\u0b33 \u0b15\u0b33\u0b3e \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b28\u0b40\u0b33 \u0b15\u0b32\u0b2e \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41","Write all the answers, including MCQs and fill-in-the-blanks, on the piece of paper":"\u0b15\u0b3e\u0b17\u0b1c\u0b30\u0b47 MCQ \u0b0f\u0b2c\u0b02 \u0b16\u0b3e\u0b32\u0b3f\u0b38\u0b4d\u0b25\u0b3e\u0b28 \u0b2a\u0b42\u0b30\u0b23 \u0b38\u0b2e\u0b47\u0b24 \u0b38\u0b2e\u0b38\u0b4d\u0b24 \u0b09\u0b24\u0b4d\u0b24\u0b30 \u0b32\u0b47\u0b16\u0b28\u0b4d\u0b24\u0b41\u0964","Use the same numbering system as the question paper; take extra care to write the numbers clearly":"\u0b2a\u0b4d\u0b30\u0b36\u0b4d\u0b28\u0b2a\u0b24\u0b4d\u0b30 \u0b2a\u0b30\u0b3f \u0b38\u0b2e\u0b3e\u0b28 \u0b38\u0b02\u0b16\u0b4d\u0b5f\u0b3e \u0b2a\u0b4d\u0b30\u0b23\u0b3e\u0b33\u0b40 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41; \u0b38\u0b02\u0b16\u0b4d\u0b5f\u0b3e\u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15\u0b41 \u0b38\u0b4d\u0b2a\u0b37\u0b4d\u0b1f \u0b2d\u0b3e\u0b2c\u0b30\u0b47 \u0b32\u0b47\u0b16\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b05\u0b27\u0b3f\u0b15 \u0b2f\u0b24\u0b4d\u0b28 \u0b28\u0b3f\u0b05\u0b28\u0b4d\u0b24\u0b41\u0964","Write clearly and make sure the letters do not touch the edges of the page. If a mistake is made, strike it out neatly and write it again":"\u0b38\u0b4d\u0b2a\u0b37\u0b4d\u0b1f \u0b2d\u0b3e\u0b2c\u0b30\u0b47 \u0b32\u0b47\u0b16\u0b28\u0b4d\u0b24\u0b41 \u0b0f\u0b2c\u0b02 \u0b28\u0b3f\u0b36\u0b4d\u0b1a\u0b3f\u0b24 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 \u0b2f\u0b47 \u0b05\u0b15\u0b4d\u0b37\u0b30\u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15 \u0b2a\u0b43\u0b37\u0b4d\u0b20\u0b3e\u0b30 \u0b15\u0b21\u0b3c\u0b15\u0b41 \u0b38\u0b4d\u0b2a\u0b30\u0b4d\u0b36 \u0b15\u0b30\u0b41\u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964 \u0b2f\u0b26\u0b3f \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2d\u0b41\u0b32 \u0b39\u0b41\u0b0f, \u0b24\u0b47\u0b2c\u0b47 \u0b0f\u0b39\u0b3e\u0b15\u0b41 \u0b38\u0b2b\u0b3e\u0b38\u0b41\u0b24\u0b41\u0b30\u0b3e \u0b2d\u0b3e\u0b2c\u0b30\u0b47 \u0b15\u0b3e\u0b1f\u0b3f \u0b2a\u0b41\u0b23\u0b3f \u0b25\u0b30\u0b47 \u0b32\u0b47\u0b16\u0b28\u0b4d\u0b24\u0b41\u0964","Processing...":"\u0b2a\u0b4d\u0b30\u0b15\u0b4d\u0b30\u0b3f\u0b5f\u0b3e\u0b15\u0b30\u0b23 \u0b39\u0b47\u0b09\u0b1b\u0b3f...","Processing images...":"\u0b1b\u0b2c\u0b3f\u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15 \u0b2a\u0b4d\u0b30\u0b15\u0b4d\u0b30\u0b3f\u0b5f\u0b3e\u0b15\u0b30\u0b23 \u0b39\u0b47\u0b09\u0b1b\u0b3f...","We recommend uploading up to 20 images":"\u0b06\u0b2e\u0b47 20\u0b1f\u0b3f \u0b2a\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b28\u0b4d\u0b24 \u0b1b\u0b2c\u0b3f \u0b05\u0b2a\u0b32\u0b4b\u0b21\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b38\u0b41\u0b2a\u0b3e\u0b30\u0b3f\u0b36 \u0b15\u0b30\u0b41\u0b1b\u0b41","Submit for Review":"\u0b30\u0b3f\u0b2d\u0b3f\u0b5f\u0b41 \u0b2a\u0b3e\u0b07\u0b01 \u0b38\u0b2c\u0b2e\u0b3f\u0b1f \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41",Uploading:"\u0b05\u0b2a\u0b32\u0b4b\u0b21\u0b4d \u0b39\u0b47\u0b09\u0b1b\u0b3f","Uploading Files":"\u0b2b\u0b3e\u0b07\u0b32\u0b4d\u200c\u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15 \u0b05\u0b2a\u0b32\u0b4b\u0b21\u0b4d \u0b39\u0b47\u0b09\u0b1b\u0b3f","Images are successfully uploaded":"\u0b1b\u0b2c\u0b3f\u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15 \u0b38\u0b2b\u0b33\u0b24\u0b3e\u0b30 \u0b38\u0b39 \u0b05\u0b2a\u0b32\u0b4b\u0b21\u0b4d \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b1b\u0b3f","Failed to upload images. Please try again.":"\u0b1b\u0b2c\u0b3f\u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15 \u0b05\u0b2a\u0b32\u0b4b\u0b21\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b30\u0b47 \u0b2c\u0b3f\u0b2b\u0b33 \u0b39\u0b47\u0b32\u0b3e\u0964 \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b2a\u0b41\u0b23\u0b3f \u0b1a\u0b47\u0b37\u0b4d\u0b1f\u0b3e \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964","No Images":"\u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b1b\u0b2c\u0b3f \u0b28\u0b3e\u0b39\u0b3f\u0b01","Please select images to upload.":"\u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b05\u0b2a\u0b32\u0b4b\u0b21\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b1b\u0b2c\u0b3f\u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15\u0b41 \u0b1a\u0b5f\u0b28 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964",Error:"\u0b24\u0b4d\u0b30\u0b41\u0b1f\u0b3f","Failed to capture photo. Please try again.":"\u0b2b\u0b1f\u0b4b \u0b15\u0b4d\u0b5f\u0b3e\u0b2a\u0b4d\u200d\u0b1a\u0b30\u0b4d\u200d \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b32\u0b3e \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964 \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b2a\u0b41\u0b23\u0b3f \u0b1a\u0b47\u0b37\u0b4d\u0b1f\u0b3e \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964","Failed to select images. Please try again.":"\u0b1b\u0b2c\u0b3f \u0b1a\u0b5f\u0b28 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b30\u0b47 \u0b2c\u0b3f\u0b2b\u0b33 \u0b39\u0b47\u0b32\u0b3e\u0964 \u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b2a\u0b41\u0b23\u0b3f \u0b1a\u0b47\u0b37\u0b4d\u0b1f\u0b3e \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964","Your answers have been successfully submitted for evaluation":"\u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b30 \u0b09\u0b24\u0b4d\u0b24\u0b30\u0b17\u0b41\u0b21\u0b3f\u0b15 \u0b38\u0b2b\u0b33\u0b24\u0b3e\u0b30 \u0b38\u0b39 \u0b2e\u0b42\u0b32\u0b4d\u0b5f\u0b3e\u0b19\u0b4d\u0b15\u0b28 \u0b2a\u0b3e\u0b07\u0b01 \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b1b\u0b3f\u0964","You'll be notified as soon as the evaluation is complete.":"\u0b2e\u0b42\u0b32\u0b4d\u0b5f\u0b3e\u0b19\u0b4d\u0b15\u0b28 \u0b38\u0b2e\u0b3e\u0b2a\u0b4d\u0b24 \u0b39\u0b47\u0b2c\u0b3e \u0b2e\u0b3e\u0b24\u0b4d\u0b30\u0b47 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b41 \u0b38\u0b42\u0b1a\u0b3f\u0b24 \u0b15\u0b30\u0b3e\u0b2f\u0b3f\u0b2c\u0964","In the meantime, make sure you've submitted all required answers correctly. If you face any issues, please reach out to your facilitator.":"\u0b0f\u0b39\u0b3f \u0b38\u0b2e\u0b5f \u0b2e\u0b27\u0b4d\u0b5f\u0b30\u0b47 \u0b38\u0b2e\u0b38\u0b4d\u0b24 \u0b06\u0b2c\u0b36\u0b4d\u0b5f\u0b15 \u0b09\u0b24\u0b4d\u0b24\u0b30 \u0b38\u0b20\u0b3f\u0b15\u0b4d \u0b2d\u0b3e\u0b2c\u0b30\u0b47 \u0b26\u0b3e\u0b16\u0b32 \u0b39\u0b4b\u0b07\u0b1b\u0b3f \u0b15\u0b3f \u0b28\u0b3e\u0b39\u0b3f\u0b01 \u0b26\u0b47\u0b16\u0b28\u0b4d\u0b24\u0b41\u0964 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b38\u0b2e\u0b38\u0b4d\u0b5f\u0b3e \u0b39\u0b47\u0b32\u0b47 \u0b2b\u0b3e\u0b38\u0b3f\u0b32\u0b3f\u0b1f\u0b47\u0b1f\u0b30\u0b19\u0b4d\u0b15 \u0b38\u0b39\u0b3f\u0b24 \u0b2f\u0b4b\u0b17\u0b3e\u0b2f\u0b4b\u0b17 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964\"","Loading assessment data...":"\u0b2e\u0b42\u0b32\u0b4d\u0b5f\u0b3e\u0b19\u0b4d\u0b15\u0b28 \u0b21\u0b3e\u0b1f\u0b3e \u0b32\u0b4b\u0b21\u0b4d \u0b39\u0b47\u0b09\u0b1b\u0b3f...","No assessment data available yet":"\u0b0f\u0b2a\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b28\u0b4d\u0b24 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2e\u0b42\u0b32\u0b4d\u0b5f\u0b3e\u0b19\u0b4d\u0b15\u0b28 \u0b24\u0b25\u0b4d\u0b5f \u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964",Image:"\u0b2a\u0b4d\u0b30\u0b24\u0b3f\u0b1b\u0b2c\u0b3f","Images Uploaded":"\u0b05\u0b2a\u0b32\u0b4b\u0b21\u0b4d \u0b39\u0b4b\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b1b\u0b2c\u0b3f\u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15","Permission Test Component":"\u0b05\u0b28\u0b41\u0b2e\u0b24\u0b3f \u0b2a\u0b30\u0b40\u0b15\u0b4d\u0b37\u0b3e \u0b09\u0b2a\u0b3e\u0b26\u0b3e\u0b28","Check Permissions":"\u0b05\u0b28\u0b41\u0b2e\u0b24\u0b3f \u0b2f\u0b3e\u0b1e\u0b4d\u0b1a \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41","Request Permissions":"\u0b05\u0b28\u0b41\u0b2e\u0b24\u0b3f \u0b2a\u0b3e\u0b07\u0b01 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41","Permission Status":"\u0b05\u0b28\u0b41\u0b2e\u0b24\u0b3f \u0b38\u0b4d\u0b25\u0b3f\u0b2