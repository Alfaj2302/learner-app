cb8\u0ccd\u0c9f\u0cae\u0cc8\u0cb8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",username:"\u0caf\u0cc2\u0cb8\u0cb0\u0ccd  \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1",password:"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd",forgot_password:"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cae\u0cb0\u0cc6\u0ca4\u0cbf\u0cb0\u0cc1\u0cb5\u0cbf\u0cb0\u0cbe",remember_me:"\u0ca8\u0ca8\u0ccd\u0ca8\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc6\u0ca8\u0caa\u0cbf\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0ca1\u0cbf",is_required:"\u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6",min:"\u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0",max:"\u0c97\u0cb0\u0cbf\u0cb7\u0ccd\u0ca0",characters:"\u0c85\u0c95\u0ccd\u0cb7\u0cb0\u0c97\u0cb3\u0cc1",Password_must_match:"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0cac\u0cc7\u0c95\u0cc1",can_only_contain_letters:"\u0c95\u0cc7\u0cb5\u0cb2 \u0c85\u0c95\u0ccd\u0cb7\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0c92\u0cb3\u0c97\u0cca\u0c82\u0ca1\u0cbf\u0cb0\u0cac\u0cb9\u0cc1\u0ca6\u0cc1",Choose_at_least:"\u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf",cards_can_be_selected:"\u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1",terms_and_conditions:"\u0c95\u0cca\u0ca8\u0cc6\u0caf\u0ca6\u0cbe\u0c97\u0cbf, \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c95\u0cb8\u0ccd\u0c9f\u0cae\u0cc8\u0cb8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0c85\u0ca8\u0cc1\u0cad\u0cb5\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0caa\u0ca1\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0caf\u0cb8\u0ccd\u0cb8\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbf\u0cb3\u0cbf\u0cb8\u0cbf. \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0caf\u0cc1 \u0cb8\u0cc2\u0c95\u0ccd\u0ca4 \u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb7\u0cb0\u0ca4\u0ccd\u0ca4\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cae\u0c97\u0cc6 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",I_am_18_or_older:"\u0ca8\u0cbe\u0ca8\u0cc1 18 \u0c85\u0ca5\u0cb5\u0cbe \u0c85\u0ca6\u0c95\u0ccd\u0c95\u0cbf\u0c82\u0ca4 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0cb5\u0caf\u0cb8\u0ccd\u0cb8\u0cbf\u0ca8\u0cb5\u0ca8\u0cc1",I_am_under_18:"\u0ca8\u0ca8\u0ccd\u0ca8 \u0cb5\u0caf\u0cb8\u0ccd\u0cb8\u0cc1 18 \u0cb5\u0cb0\u0ccd\u0cb7\u0c95\u0ccd\u0c95\u0cbf\u0c82\u0ca4 \u0c95\u0ca1\u0cbf\u0cae\u0cc6","T&C":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 \u0c97\u0ccc\u0caa\u0ccd\u0caf\u0ca4\u0cbe \u0ca8\u0cc0\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cca\u0ca8\u0cc6\u0caf\u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cbe\u0cb2\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0c93\u0ca6\u0cbf, \u0c87\u0ca6\u0cb0\u0cbf\u0c82\u0ca6 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cac\u0c9f\u0ca8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1",create_account:"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb0\u0c9a\u0cbf\u0cb8\u0cbf",button:"\u0cac\u0c9f\u0ca8\u0ccd","T&C_1":"\u0caa\u0ccd\u0cb0\u0ca5\u0cae \u0c8e\u0c9c\u0cc1\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0cab\u0ccc\u0c82\u0ca1\u0cc7\u0cb6\u0ca8\u0ccd (\u0caa\u0ccd\u0cb0\u0ca5\u0cae) \u0cad\u0cbe\u0cb0\u0ca4\u0ca6 \u0c85\u0ca4\u0cbf\u0ca6\u0cca\u0ca1\u0ccd\u0ca1 \u0c8e\u0ca8\u0ccd\u200c\u0c9c\u0cbf\u0c92\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c92\u0c82\u0ca6\u0cbe\u0c97\u0cbf\u0ca6\u0cc6, \u0c87\u0ca6\u0cb0 \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0c95\u0c9a\u0cc7\u0cb0\u0cbf \u0cae\u0cc1\u0c82\u0cac\u0cc8\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0ca6\u0cc6. \u0caa\u0ccd\u0cb0\u0ca5\u0cae 25 \u0cb5\u0cb0\u0ccd\u0cb7\u0c97\u0cb3\u0cbf\u0c97\u0cbf\u0c82\u0ca4 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1 \u0c95\u0cbe\u0cb2 \u0cb6\u0cbf\u0c95\u0ccd\u0cb7\u0ca3 \u0c95\u0ccd\u0cb7\u0cc7\u0ca4\u0ccd\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0cc6\u0cb2\u0cb8 \u0cae\u0cbe\u0ca1\u0cbf\u0ca6\u0cc6.","T&C_2":"\u0ca8\u0cbf\u0cae\u0c97\u0cc6 \u0ca4\u0cbf\u0cb3\u0cbf\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0c82\u0ca4\u0cc6, \u0ca8\u0cc0\u0cb5\u0cc1 \u0caa\u0ccd\u0cb0\u0ca5\u0cae \u0ca8\u0ca1\u0cc6\u0cb8\u0cc1\u0cb5 \u0c9a\u0c9f\u0cc1\u0cb5\u0c9f\u0cbf\u0c95\u0cc6\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cad\u0cbe\u0c97\u0cb5\u0cb9\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf. \u0c88 \u0cb8\u0c82\u0ca6\u0cb0\u0ccd\u0cad\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf, \u0caa\u0ccd\u0cb0\u0ca5\u0cae \u0ca4\u0ca8\u0ccd\u0ca8 \u0cb8\u0ccd\u0cb5\u0caf\u0c82\u0cb8\u0cc7\u0cb5\u0c95\u0cb0\u0cc1/\u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0ca8\u0cbf\u0ca7\u0cbf\u0c97\u0cb3 \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca1\u0cc7\u0c9f\u0cbe\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6, \u0c87\u0ca6\u0cb0\u0cb2\u0ccd\u0cb2\u0cbf \u0c9a\u0c9f\u0cc1\u0cb5\u0c9f\u0cbf\u0c95\u0cc6\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cad\u0cbe\u0c97\u0cb5\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5\u0cbe\u0c97 \u0cae\u0cc2\u0cb2 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cc1, \u0cb8\u0ccd\u0ca5\u0cb3, \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf, \u0c95\u0cb2\u0cbf\u0c95\u0cc6 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0ca4 \u0ca1\u0cc7\u0c9f\u0cbe, \u0c9a\u0cbf\u0ca4\u0ccd\u0cb0\u0c97\u0cb3\u0cc1/\u0cab\u0ccb\u0c9f\u0ccb\u0c97\u0cb3\u0cc1, \u0cb5\u0cc0\u0ca1\u0cbf\u0caf\u0cca\u0c97\u0cb3\u0cc1, \u0ca7\u0ccd\u0cb5\u0ca8\u0cbf \u0cb0\u0cc6\u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1 (\u2018\u0cb5\u0cb8\u0ccd\u0ca4\u0cc1\u0c97\u0cb3\u0cc1\u2019) \u0cb8\u0cc7\u0cb0\u0cbf\u0cb5\u0cc6 \u0c86\u0ca6\u0cb0\u0cc6 \u0c87\u0cb5\u0cc1\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0cb8\u0cc0\u0cae\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf\u0cb2\u0ccd\u0cb2.","T&C_3":"\u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0cb8\u0cbf\u0ca6 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf/\u0cb5\u0cb8\u0ccd\u0ca4\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c88 \u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 \u0c89\u0ca6\u0ccd\u0ca6\u0cc7\u0cb6\u0c97\u0cb3\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0cad\u0cbe\u0c97\u0cb6\u0c83 \u0c85\u0ca5\u0cb5\u0cbe \u0cb8\u0c82\u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0cb5\u0cbe\u0c97\u0cbf \u0cac\u0cb3\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6:","T&C_4":"1. \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0c95\u0ccd\u0cb0\u0cae \u0c9c\u0cbe\u0cb0\u0cbf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5\u0cbf\u0c95\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cc1\u0ca7\u0cbe\u0cb0\u0ca3\u0cc6, \u0cb8\u0cae\u0cc1\u0ca6\u0cbe\u0caf \u0ca4\u0cca\u0ca1\u0c97\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0cb5\u0cbf\u0c95\u0cc6, \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cb0\u0ca6\u0cbf \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0c89\u0ca6\u0ccd\u0ca6\u0cc7\u0cb6\u0c97\u0cb3\u0cc1.","T&C_5":"2. \u0caa\u0ccd\u0cb0\u0ca5\u0cae\u0ca6 \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb6\u0ca8\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf, \u0ca6\u0cbe\u0ca8\u0cbf\u0c97\u0cb3 \u0cb5\u0cb0\u0ca6\u0cbf\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf (\u0cad\u0cbe\u0cb0\u0ca4\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0c82\u0ca4\u0cb0\u0cb0\u0cbe\u0cb7\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0caf\u0cb5\u0cbe\u0c97\u0cbf), \u0cae\u0cbe\u0ca7\u0ccd\u0caf\u0cae \u0c9a\u0c9f\u0cc1\u0cb5\u0c9f\u0cbf\u0c95\u0cc6\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf, \u0cb8\u0cbe\u0cae\u0cbe\u0c9c\u0cbf\u0c95 \u0cae\u0cbe\u0ca7\u0ccd\u0caf\u0cae \u0c9a\u0c9f\u0cc1\u0cb5\u0c9f\u0cbf\u0c95\u0cc6\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf (\u0c89\u0ca6\u0cbe.: \u0cab\u0cc7\u0cb8\u0ccd\u200c\u0cac\u0cc1\u0c95\u0ccd, \u0caf\u0cc2\u0c9f\u0ccd\u0caf\u0cc2\u0cac\u0ccd, \u0c87\u0ca8\u0ccd\u200c\u0cb8\u0ccd\u0c9f\u0cbe\u0c97\u0ccd\u0cb0\u0cbe\u0cae\u0ccd, \u0cb2\u0cbf\u0c82\u0c95\u0ccd\u0ca1\u0ccd\u200c\u0c87\u0ca8\u0ccd, \u0c9f\u0ccd\u0cb5\u0cbf\u0c9f\u0cb0\u0ccd, \u0ca5\u0ccd\u0cb0\u0cc6\u0ca1\u0ccd\u0cb8\u0ccd \u0c87\u0ca4\u0ccd\u0caf\u0cbe\u0ca6\u0cbf), \u0ca1\u0cbf\u0c9c\u0cbf\u0c9f\u0cb2\u0ccd \u0cb5\u0cc7\u0ca6\u0cbf\u0c95\u0cc6\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c9a\u0c9f\u0cc1\u0cb5\u0c9f\u0cbf\u0c95\u0cc6\u0c97\u0cb3\u0cc1 (\u0c89\u0ca6\u0cbe.: \u0caa\u0ccd\u0cb0\u0ca5\u0cae\u0ca6 \u0cb5\u0cc6\u0cac\u0ccd\u200c\u0cb8\u0cc8\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0cc1). \u0c87\u0cb5\u0cc1 \u0cb6\u0cc8\u0c95\u0ccd\u0cb7\u0ca3\u0cbf\u0c95 \u0c9a\u0c9f\u0cc1\u0cb5\u0c9f\u0cbf\u0c95\u0cc6\u0c97\u0cb3 \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0c9c\u0cbe\u0c97\u0cc3\u0ca4\u0cbf \u0cae\u0cc2\u0ca1\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0cb3\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6.","T&C_6":"3. \u0caa\u0ccd\u0cb0\u0ca5\u0cae\u0ca6 \u0ca6\u0cbe\u0ca8\u0cbe\u0ca4\u0ccd\u0cae\u0c95 \u0c95\u0cc6\u0cb2\u0cb8\u0ca6 \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0c9c\u0cbe\u0c97\u0cc3\u0ca4\u0cbf \u0cae\u0cc2\u0ca1\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca6\u0cbe\u0ca8\u0cbf\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 (\u0cad\u0cbe\u0cb0\u0ca4\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0c82\u0ca4\u0cb0\u0cb0\u0cbe\u0cb7\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0caf\u0cb5\u0cbe\u0c97\u0cbf) \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1.","T&C_7":"\u0cae\u0cc7\u0cb2\u0cc6 \u0ca4\u0cbf\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf/\u0cb5\u0cb8\u0ccd\u0ca4\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1, \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0cb3\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0cae\u0ccd\u0cae\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0ca1\u0cc1\u0cb5\u0c82\u0ca4\u0cc6 \u0c95\u0ccb\u0cb0\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c86\u0ca6\u0cbe\u0c97\u0ccd\u0caf\u0cc2, \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf/\u0cb5\u0cb8\u0ccd\u0ca4\u0cc1\u0c97\u0cb3 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0ca3\u0cc6\u0c97\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0cae\u0ccd\u0cae\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0cbe\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","T&C_8":"\u0ca8\u0ca8\u0c97\u0cc6 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0cb8\u0cbf\u0ca6 \u0cae\u0cc7\u0cb2\u0cc6 \u0ca4\u0cbf\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb5\u0cb8\u0ccd\u0ca4\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cac\u0cb2\u0cb5\u0c82\u0ca4\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2\u0ca6\u0cc6 \u0cac\u0cb3\u0cb8\u0cb2\u0cc1, \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1, \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1, \u0caa\u0ccd\u0cb0\u0c95\u0c9f\u0cbf\u0cb8\u0cb2\u0cc1 \u0caa\u0ccd\u0cb0\u0ca5\u0cae\u0ccd, \u0c85\u0ca6\u0cb0 \u0cb8\u0ccd\u0cb5\u0caf\u0c82\u0cb8\u0cc7\u0cb5\u0c95\u0cb0\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1/\u0c85\u0ca5\u0cb5\u0cbe \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0ca8\u0cbf\u0ca7\u0cbf\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0ca8\u0cbe\u0ca8\u0cc1 \u0cb8\u0cae\u0ccd\u0cae\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6.","T&C_9":"\u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb8\u0cae\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0ca8\u0ccd\u0ca8 \u0ca1\u0cc7\u0c9f\u0cbe/\u0cab\u0ccb\u0c9f\u0ccb/\u0cb5\u0cc0\u0ca1\u0cbf\u0caf\u0cca\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0ca5\u0cae\u0ca6 \u0cb5\u0cc6\u0cac\u0ccd\u200c\u0cb8\u0cc8\u0c9f\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9 \u0cb5\u0cc7\u0ca6\u0cbf\u0c95\u0cc6\u0c97\u0cb3\u0cbf\u0c82\u0ca6 \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0cb9\u0cbe\u0c95\u0cac\u0cc7\u0c95\u0cc1, \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0cb8\u0cb0\u0cbf\u0caa\u0ca1\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc6\u0c82\u0ca6\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0ca7\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc6, \u0ca8\u0cbe\u0ca8\u0cc1 \u0cab\u0ccb\u0ca8\u0ccd/\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0caa\u0ccd\u0cb0\u0ca5\u0cae\u0ca6 \u0cb8\u0ccd\u0cb5\u0caf\u0c82\u0cb8\u0cc7\u0cb5\u0c95/\u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0ca8\u0cbf\u0ca7\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6, \u0c87\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0cbf\u0c96\u0cbf\u0ca4 \u0cb9\u0cbf\u0c82\u0caa\u0ca1\u0cc6\u0caf\u0cc1\u0cb5\u0cbf\u0c95\u0cc6/\u0cb8\u0cae\u0ccd\u0cae\u0ca4\u0cbf\u0caf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0ca6\u0cbf\u0c82\u0ca6 \u0c85\u0ca8\u0cc1\u0cb8\u0cb0\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c86 \u0ca8\u0c82\u0ca4\u0cb0, \u0caa\u0ccd\u0cb0\u0ca5\u0cae, \u0c85\u0ca6\u0cb0 \u0cb8\u0ccd\u0cb5\u0caf\u0c82\u0cb8\u0cc7\u0cb5\u0c95\u0cb0\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1/\u0c85\u0ca5\u0cb5\u0cbe \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0ca8\u0cbf\u0ca7\u0cbf\u0c97\u0cb3\u0cc1 15 \u0c95\u0cc6\u0cb2\u0cb8\u0ca6 \u0ca6\u0cbf\u0ca8\u0c97\u0cb3 \u0c92\u0cb3\u0c97\u0cc6 \u0c85\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0cb9\u0cbe\u0c95\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe \u0cb8\u0cb0\u0cbf\u0caa\u0ca1\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6/\u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6. \u0c88 \u0cb8\u0c82\u0ca6\u0cb0\u0ccd\u0cad\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf, \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cc6\u0cb3\u0c97\u0cc6 \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.","T&C_10":"\u0cae\u0cc7\u0cb2\u0cc6 \u0ca4\u0cbf\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0cb5\u0cbf\u0cb7\u0caf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbe\u0ca8\u0cc1 \u0cb8\u0ccd\u0ca5\u0cb3\u0cc0\u0caf \u0cad\u0cbe\u0cb7\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0c93\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1/\u0c85\u0ca5\u0cb5\u0cbe \u0cb5\u0cbf\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf\u0ca8 \u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3 \u0cb5\u0cbf\u0cb7\u0caf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0cb5\u0cbe\u0c97\u0cbf \u0c85\u0cb0\u0ccd\u0ca5\u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6. \u0ca8\u0ca8\u0ccd\u0ca8 \u0cb8\u0cbe\u0cae\u0c97\u0ccd\u0cb0\u0cbf\u0c97\u0cb3\u0cc1/\u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf \u0cae\u0cc7\u0cb2\u0cc6 \u0ca4\u0cbf\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0cac\u0cb3\u0c95\u0cc6\u0caf \u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0ca8\u0cbe\u0ca8\u0cc1 \u0c88 \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0ca8\u0ccd\u0ca8 \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c97\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0c82\u0ca4\u0cb9 \u0cac\u0cb3\u0c95\u0cc6\u0c97\u0cc6 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0cb8\u0cbf\u0ca6\u0c82\u0ca4\u0cc6 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb9\u0c95\u0ccd\u0c95\u0cc1 \u0cb8\u0cbe\u0ca7\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2.","T&C_11":"\u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1: \u0caa\u0ccd\u0cb0\u0ca5\u0cae \u0c8e\u0c9c\u0cc1\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0cab\u0ccc\u0c82\u0ca1\u0cc7\u0cb6\u0ca8\u0ccd",office_adrress:"\u0ca6\u0cc6\u0cb9\u0cb2\u0cbf \u0c95\u0c9a\u0cc7\u0cb0\u0cbf: B4/59, \u0cb8\u0cab\u0ccd\u0ca6\u0cb0\u0ccd\u200c\u0c9c\u0c82\u0c97\u0ccd \u0c8e\u0ca8\u0ccd\u200c\u0c95\u0ccd\u0cb2\u0cc7\u0cb5\u0ccd, \u0ca8\u0cb5\u0ca6\u0cc6\u0cb9\u0cb2\u0cbf-110029",office_email:"\u0c87\u0cae\u0cc7\u0cb2\u0ccd: dataprotectionofficer@pratham.org",office_phone:"\u0cab\u0ccb\u0ca8\u0ccd \u0cb8\u0c82: 011-26177200",office_website:"| www.pratham.org |",office_cin:"CIN: U80101MH2002NPL136300","T&C_12":"\u0ca8\u0cbe\u0ca8\u0cc1 \u0c97\u0ccc\u0caa\u0ccd\u0caf\u0ca4\u0cbe \u0ca8\u0cc0\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c93\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cae\u0ccd\u0cae\u0ca4\u0cbf \u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb5\u0cbf\u0cb5\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6\u0c82\u0ca4\u0cc6 \u0ca8\u0ca8\u0ccd\u0ca8 \u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 \u0ca1\u0cc7\u0c9f\u0cbe\u0ca6 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0ca3\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0cb3\u0c95\u0cc6\u0c97\u0cc6 \u0cb8\u0cae\u0ccd\u0cae\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6.","T&C_13":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0caa\u0cc1\u0c9f\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u2018\u0ca1\u0cc7\u0c9f\u0cbe \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c97\u0ccc\u0caa\u0ccd\u0caf\u0ca4\u0cbe \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u2019\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cbf\u0c82\u0ca6 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb8\u0cae\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0ca1\u0cc7\u0c9f\u0cbe \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0cb9\u0cbe\u0c95\u0cb2\u0cc1, \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c95\u0ccb\u0cb0\u0cbf\u0c95\u0cc6 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",username_already_exists:"\u0caf\u0cc2\u0cb8\u0cb0\u0ccd  \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0c88\u0c97\u0cbe\u0c97\u0cb2\u0cc7 \u0c87\u0ca6\u0cc6",username_is_already_exists_in_keycloak:"\u0caf\u0cc2\u0cb8\u0cb0\u0ccd \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0c88\u0c97\u0cbe\u0c97\u0cb2\u0cc7 \u0c87\u0ca6\u0cc6",something_went_wrong_try_again_later:"\u0c8f\u0ca8\u0ccb \u0ca4\u0caa\u0ccd\u0caa\u0cbe\u0c97\u0cbf\u0ca6\u0cc6, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0c82\u0ca4\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.",Learning_Content:"\u0c95\u0cb2\u0cbf\u0c95\u0cc6\u0caf \u0cb5\u0cbf\u0cb7\u0caf",Update_your_preferences_to_get_the_best_picks_just_for_you:"\u0ca8\u0cbf\u0cae\u0c97\u0cbe\u0c97\u0cbf \u0c89\u0ca4\u0ccd\u0ca4\u0cae \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf!",Based_on_Your_Interests:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0cb8\u0c95\u0ccd\u0ca4\u0cbf\u0c97\u0cb3 \u0c86\u0ca7\u0cbe\u0cb0\u0ca6 \u0cae\u0cc7\u0cb2\u0cc6",view_all:"\u0c8e\u0cb2\u0ccd\u0cb2\u0cb5\u0ca8\u0ccd\u0ca8\u0cc2 \u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cbf",Financial_Literacy:"\u0c86\u0cb0\u0ccd\u0ca5\u0cbf\u0c95 \u0c9c\u0ccd\u0c9e\u0cbe\u0ca8",Continue_Learning:"\u0c85\u0ca7\u0ccd\u0caf\u0caf\u0ca8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf",Preferences:"\u0c86\u0ca7\u0cbf\u0c95\u0cc3\u0ca4\u0ca4\u0cc6\u0c97\u0cb3\u0cc1",Food_Production:"\u0c86\u0cb9\u0cbe\u0cb0 \u0c89\u0ca4\u0ccd\u0caa\u0cbe\u0ca6\u0ca8\u0cc6",Conceptual_Thinking:"\u0c86\u0c97\u0ca4\u0ccd\u0caf \u0c9a\u0cbf\u0c82\u0ca4\u0ca8\u0cc6",Todays_Top_Pick:"\u0c87\u0c82\u0ca6\u0cbf\u0ca8 \u0c9f\u0cbe\u0caa\u0ccd \u0c86\u0caf\u0ccd\u0c95\u0cc6",Art:"\u0c95\u0cb2\u0cc6",Assessments:"\u0cae\u0ccc\u0cb2\u0ccd\u0caf\u0cae\u0cbe\u0caa\u0ca8\u0c97\u0cb3\u0cc1",assessment:"\u0cae\u0ccc\u0cb2\u0ccd\u0caf\u0cae\u0cbe\u0caa\u0ca8","pre-test":"\u0caa\u0cc2\u0cb0\u0ccd\u0cb5 \u0caa\u0cb0\u0cc0\u0c95\u0ccd\u0cb7\u0cc6","post-test":"\u0caa\u0cb0\u0cbf\u0cb7\u0ccd\u0c95\u0cb0\u0ca3\u0cc6 \u0caa\u0cb0\u0cc0\u0c95\u0ccd\u0cb7\u0cc6",Inprogress:"\u0caa\u0ccd\u0cb0\u0c97\u0ca4\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0ca6\u0cc6",Overallscore:"\u0c92\u0c9f\u0ccd\u0c9f\u0cc1 \u0c85\u0c82\u0c95\u0c97\u0cb3\u0cc1",completed:"\u0caa\u0cc2\u0cb0\u0cc8\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",take_the_test:"\u0caa\u0cb0\u0cc0\u0c95\u0ccd\u0cb7\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf",not_started:"\u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cbf\u0cb2\u0ccd\u0cb2",submitted_On:"\u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0caf\u0cbf\u0ca4\u0cc1",reading:"\u0c93\u0ca6\u0cc1",out_of:"\u0cb9\u0cca\u0cb0\u0c97\u0cc6",correct_answers:"\u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0c97\u0cb3\u0cc1",assessment_note:"\u0c97\u0cae\u0ca8\u0cbf\u0cb8\u0cbf: \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cc2\u0cb0\u0ccd\u0cb5 \u0caa\u0cb0\u0cc0\u0c95\u0ccd\u0cb7\u0cc6 \u0c8e\u0cb2\u0ccd\u0cb2 \u0cb5\u0cbf\u0cb7\u0caf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0caa\u0cb0\u0cbf\u0c97\u0ca3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1",assessment_instructions:"\u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0cb5\u0cbf\u0cb7\u0caf\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0caa\u0cb0\u0cc0\u0c95\u0ccd\u0cb7\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf. \u0ca8\u0cc0\u0cb5\u0cc1 \u0c85\u0cb5\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c95\u0ccd\u0cb0\u0cae\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cb8\u0ccd\u0cb5\u0ca4\u0c82\u0ca4\u0ccd\u0cb0\u0cb0\u0cbe\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf",instruction1:"\u0c85\u0cb5\u0ca7\u0cbf: \u0caa\u0cb0\u0cc0\u0c95\u0ccd\u0cb7\u0cc6 \u0cb8\u0cae\u0caf\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1 20 \u0ca8\u0cbf\u0cae\u0cbf\u0cb7\u0c97\u0cb3 \u0c95\u0cbe\u0cb2 \u0ca8\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb8\u0cae\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cbf",instruction2:"\u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6\u0c97\u0cb3 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6: \u0caa\u0cb0\u0cc0\u0c95\u0ccd\u0cb7\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cac\u0cb9\u0cc1\u0caa\u0cbe\u0cb2\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6\u0c97\u0cb3\u0cc1 \u0c87\u0cb5\u0cc6. \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0ca6\u0cbf\u0cb7\u0ccd\u0c9f \u0cb8\u0cae\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cc0\u0ca1\u0cb2\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0caa\u0ca1\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf",instruction3:"\u0cb8\u0cae\u0cb0\u0ccd\u0caa\u0ca3\u0cc6: \u0ca8\u0cc0\u0cb5\u0cc1 \u0caa\u0cb0\u0cc0\u0c95\u0ccd\u0cb7\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0c82\u0ca6\u0cc7 \u0cac\u0cbe\u0cb0\u0cbf \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c85\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ca4\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf\u0cb0\u0cbf, \u0c8f\u0c95\u0cc6\u0c82\u0ca6\u0cb0\u0cc6 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cca\u0cae\u0ccd\u0cae\u0cc6 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0cb5\u0c95\u0cbe\u0cb6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2",instruction4:"\u0caa\u0cb0\u0cc0\u0c95\u0ccd\u0cb7\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1: \u0ca8\u0cc0\u0cb5\u0cc1 \u0c85\u0c95\u0ccd\u0cb0\u0cae\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6 \u0c8e\u0c82\u0ca6\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0caa\u0ca1\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0c82\u0c9f\u0cb0\u0ccd\u0ca8\u0cc6\u0c9f\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cb8\u0ccd\u0ca5\u0cbf\u0cb0\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",instruction5:"\u0caa\u0cb0\u0cc0\u0c95\u0ccd\u0cb7\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1: \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0caf\u0cca\u0c82\u0ca6\u0cc1 \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c97\u0cae\u0ca8\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c93\u0ca6\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf. \u0ca8\u0cc0\u0cb5\u0cc1 \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cbe\u0cb0\u0cbf\u0ca6\u0cb0\u0cc2 \u0ca8\u0c82\u0ca4\u0cb0 \u0c85\u0cb5\u0cc1\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cac\u0cb9\u0cc1\u0ca6\u0cc1, \u0c86\u0ca6\u0cb0\u0cc6 \u0c9f\u0cc8\u0cae\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c97\u0cae\u0ca8\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0ccb\u0ca1\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf. \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cc6\u0cb8\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb9\u0cbf\u0c82\u0ca6\u0c95\u0ccd\u0c95\u0cc6 \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cc6\u0cb8\u0cbf\u0ca6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb9\u0cbf\u0c82\u0ca6\u0cbf\u0ca8 \u0cac\u0c9f\u0ca8\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cbf","Read_T_&_C":"\u0ca8\u0cbe\u0ca8\u0cc1 \u0c93\u0ca6\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c97\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",terms_and_conditions2:"\u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb7\u0cb0\u0ca4\u0ccd\u0ca4\u0cc1\u0c97\u0cb3\u0cc1",no_data_found:"\u0c8e \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0ca1\u0cc7\u0c9f\u0cbe \u0c95\u0c82\u0ca1\u0cc1\u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2",my_profile:"\u0ca8\u0ca8\u0ccd\u0ca8 \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd",second_chance_program:"\u0cb8\u0cc6\u0c95\u0c82\u0ca1\u0ccd \u0c9a\u0cbe\u0ca8\u0ccd\u0cb8\u0ccd  \u0caa\u0ccd\u0cb0\u0ccb\u0c97\u0ccd\u0cb0\u0cbe\u0c82",pathways:"\u0cae\u0cbe\u0cb0\u0ccd\u0c97\u0c97\u0cb3\u0cc1",logout:"\u0cb2\u0cbe\u0c97\u0ccd\u200c\u0c94\u0c9f\u0ccd",general_instructions:"\u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0ca8\u0cbf\u0cb0\u0ccd\u0ca6\u0cc7\u0cb6\u0ca8\u0c97\u0cb3\u0cc1",test_medium:"\u0caa\u0cb0\u0cc0\u0c95\u0ccd\u0cb7\u0cc6 \u0cae\u0cbe\u0ca7\u0ccd\u0caf\u0cae",board:"\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd",start_test:"\u0caa\u0cb0\u0cc0\u0c95\u0ccd\u0cb7\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cc1",block:"\u0cac\u0ccd\u0cb2\u0cbe\u0c95\u0ccd",unit:"\u0caf\u0cc1\u0ca8\u0cbf\u0c9f\u0ccd",enrollment_id:"\u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0c90\u0ca1\u0cbf",contact_number:"\u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6",class:"\u0c95\u0ccd\u0cb2\u0cbe\u0cb8\u0ccd",last_passed_grade:"\u0cb2\u0cbe\u0cb8\u0ccd\u0c9f\u0ccd  \u0caa\u0cbe\u0cb8\u0ccd  \u0c97\u0ccd\