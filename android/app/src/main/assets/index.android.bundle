_be_filled_by_parents_or_guardians:"\u0916\u093e\u0932\u0940\u0932 \u0924\u092a\u0936\u0940\u0932 \u092a\u093e\u0932\u0915 \u0915\u093f\u0902\u0935\u093e \u0938\u0902\u0930\u0915\u094d\u0937\u0915\u093e\u0928\u0947 \u092d\u0930\u0932\u0947 \u092a\u093e\u0939\u093f\u091c\u0947",parent_name:"\u092a\u093e\u0932\u0915/\u0938\u0902\u0930\u0915\u094d\u0937\u0915\u093e\u091a\u0947 \u0928\u093e\u0935",parent_phone:"\u092a\u093e\u0932\u0915/\u0938\u0902\u0930\u0915\u094d\u0937\u0915\u093e\u091a\u093e \u092b\u094b\u0928 \u0928\u0902\u092c\u0930",parent_phone_belong:"\u0939\u093e \u092b\u094b\u0928 \u0928\u0902\u092c\u0930 \u0915\u094b\u0923\u093e\u091a\u093e \u0906\u0939\u0947?",PARENT:"\u092a\u093e\u0932\u0915",GUARDIAN:"\u0938\u0902\u0930\u0915\u094d\u0937\u0915",NEIGHBOR_OTHERS:"\u0936\u0947\u091c\u093e\u0930\u0940/\u0907\u0924\u0930",create_account_desp2:"\u092e\u0940 \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u0924\u094b \u0915\u0940 \u0939\u0947 \u091a\u0947\u0915\u092c\u0949\u0915\u094d\u0938 \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092a\u093e\u0932\u0915/\u0938\u0902\u0930\u0915\u094d\u0937\u0915\u093e\u0928\u0947 \u092d\u0930\u0932\u0947 \u0906\u0939\u0947.",privacy_guidelines:"\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0915 \u0924\u0924\u094d\u0924\u094d\u0935\u0947",and_i_consent_to_the_collection_and_use_of_my_personal_data_as_described_in_the:"\u0906\u0923\u093f \u092e\u0940 \u092e\u093e\u091d\u094d\u092f\u093e \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915 \u092e\u093e\u0939\u093f\u0924\u0940\u091a\u094d\u092f\u093e \u0938\u0902\u0915\u0932\u0928 \u0906\u0923\u093f \u0935\u093e\u092a\u0930\u093e\u0938 \u0938\u0939\u092e\u0924\u0940 \u0926\u0947\u0924\u094b, \u091c\u0947 \u091c\u0938\u0947 \u0935\u0930\u094d\u0923\u0928 \u0915\u0947\u0932\u0947 \u0906\u0939\u0947",consent_form:"\u0938\u0939\u092e\u0924\u0940 \u092b\u0949\u0930\u094d\u09