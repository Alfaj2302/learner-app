47\u0917\u093e\u0964",location_des2:"! \u0930\u093e\u091c\u094d\u092f, \u091c\u093f\u0932\u093e, \u092c\u094d\u0932\u0949\u0915, \u0917\u093e\u0901\u0935 \u0915\u0940 \u0938\u0939\u0940 \u091c\u093e\u0901\u091a \u0915\u0930\u0947\u0902",numbers:"\u0938\u0902\u0916\u094d\u092f\u093e\u090f\u0901",course_modules:"\u092a\u093e\u0920\u094d\u092f\u0915\u094d\u0930\u092e \u092e\u0949\u0921\u094d\u092f\u0942\u0932\u094d\u0938",transgender:"\u0905\u0928\u094d\u092f",other:"\u0905\u0928\u094d\u092f",read_more:"\u0914\u0930 \u092a\u0922\u093c\u0947\u0902",congratulations:"\u092c\u0927\u093e\u0908 \u0939\u094b, \u0906\u092a \u0905\u092c \u0938\u0947\u0915\u0902\u0921 \u091a\u093e\u0902\u0938 \u092a\u094d\u0930\u094b\u0917\u094d\u0930\u093e\u092e \u092e\u0947\u0902 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0939\u094b \u0917\u090f \u0939\u0948\u0902!",can_only_contain_numbers:"\u0915\u0947\u0935\u0932 \u0938\u0902\u0916\u094d\u092f\u093e\u090f\u0901 \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0902",mobile:"\u092e\u094b\u092c\u093e\u0907\u0932",started_on:"\u0936\u0941\u0930\u0942 \u0939\u0941\u0906:",delete_msg:"\u0915\u094d\u092f\u093e \u0906\u092a \u0935\u093e\u0915\u0908 \u0907\u0938\u0947 \u0905\u092a\u0928\u0947 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0938\u0947 \u0939\u091f\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?",failed_msg:"\u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0935\u093f\u092b\u0932\u0964 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0921\u093f\u0938\u094d\u0915\u0928\u0947\u0915\u094d\u091f \u0939\u094b \u0917\u092f\u093e\u0964",invalid_file:"\u0905\u092e\u093e\u0928\u094d\u092f \u092b\u093c\u093e\u0907\u0932\u0964",cancel:"\u0930\u0926\u094d\u0926 \u0915\u0930\u0947\u0902",next:"\u0905\u0917\u0932\u093e",trouble_with_logging_in:"\u0932\u0949\u0917 \u0907\u0928 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u092e\u0938\u094d\u092f\u093e?",forgot_password_desp:"\u0905\u092a\u0928\u093e \u0909\u092a\u092f\u094b\u0917\