5\u0ab0\u0acb",username:"\u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe \u0aa8\u0abe\u0aae",password:"\u0aaa\u0abe\u0ab8\u0ab5\u0ab0\u0acd\u0aa1",forgot_password:"\u0aaa\u0abe\u0ab8\u0ab5\u0ab0\u0acd\u0aa1 \u0aad\u0ac2\u0ab2\u0ac0 \u0a97\u0aaf\u0abe",remember_me:"\u0aae\u0aa8\u0ac7 \u0aaf\u0abe\u0aa6 \u0ab0\u0abe\u0a96\u0acb",is_required:"\u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0a9b\u0ac7",min:"\u0aa8\u0acd\u0aaf\u0ac2\u0aa8\u0aa4\u0aae",max:"\u0aae\u0ab9\u0aa4\u0acd\u0aa4\u0aae",characters:"\u0a85\u0a95\u0acd\u0ab7\u0ab0\u0acb",Password_must_match:"\u0aaa\u0abe\u0ab8\u0ab5\u0ab0\u0acd\u0aa1 \u0aae\u0ac7\u0ab3 \u0a96\u0abe\u0ab5\u0acb \u0a9c\u0acb\u0a88\u0a8f",can_only_contain_letters:"\u0aab\u0a95\u0acd\u0aa4 \u0a85\u0a95\u0acd\u0ab7\u0ab0\u0acb \u0a9c \u0ab9\u0acb\u0a88 \u0ab6\u0a95\u0ac7",Choose_at_least:"\u0a93\u0a9b\u0abe\u0aae\u0abe\u0a82 \u0a93\u0a9b\u0ac1\u0a82 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb",cards_can_be_selected:"\u0a95\u0abe\u0ab0\u0acd\u0aa1\u0acd\u0ab8 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7",terms_and_conditions:"\u0a9b\u0ac7\u0ab2\u0acd\u0ab2\u0ac7, \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0a85\u0aa8\u0ac7 \u0a95\u0ab8\u0acd\u0a9f\u0aae\u0abe\u0a87\u0a9d\u0acd\u0aa1 \u0a85\u0aa8\u0ac1\u0aad\u0ab5\u0aa8\u0ac0 \u0a96\u0abe\u0aa4\u0ab0\u0ac0 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7, \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a85\u0aae\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0a89\u0a82\u0aae\u0ab0 \u0a9c\u0aa3\u0abe\u0ab5\u0acb. \u0aa4\u0aae\u0abe\u0ab0\u0acb \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0ab8\u0abe\u0aa6 \u0a85\u0aae\u0aa8\u0ac7 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0aa8\u0abf\u0aaf\u0aae\u0acb \u0a85\u0aa8\u0ac7 \u0ab6\u0ab0\u0aa4\u0acb \u0aaa\u0ac2\u0ab0\u0ac0 \u0aaa\u0abe\u0aa1\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aae\u0aa6\u0aa6 \u0a95\u0ab0\u0ab6\u0ac7.",I_am_18_or_older:"\u0ab9\u0ac1\u0a82 18 \u0a95\u0ac7 \u0aa4\u0ac7\u0aa5\u0ac0 \u0ab5\u0aa7\u0ac1 \u0a89\u0a82\u0aae\u0ab0\u0aa8\u0acb \u0a9b\u0ac1\u0a82",I_am_under_18:"\u0ab9\u0ac1\u0a82 18 \u0ab5\u0ab0\u0acd\u0ab7\u0aa5\u0ac0 \u0aa8\u0ac0\u0a9a\u0ac7\u0aa8\u0acb \u0a9b\u0ac1\u0a82","T&C":"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa8\u0ac0\u0a9a\u0ac7\u0aa8\u0ac0 \u0a97\u0acb\u0aaa\u0aa8\u0ac0\u0aaf\u0aa4\u0abe \u0aa8\u0ac0\u0aa4\u0abf\u0aa8\u0ac7 \u0a85\u0a82\u0aa4 \u0ab8\u0ac1\u0aa7\u0ac0 \u0ab8\u0acd\u0a95\u0acd\u0ab0\u0acb\u0ab2 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab5\u0abe\u0a82\u0a9a\u0acb, \u0a9c\u0ac7\u0aa5\u0ac0 \u0aa4\u0aae\u0ac7 \u0aac\u0a9f\u0aa8\u0aa8\u0ac7 \u0ab8\u0a95\u0acd\u0ab0\u0abf\u0aaf \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb",create_account:"\u0a96\u0abe\u0aa4\u0ac1\u0a82 \u0aac\u0aa8\u0abe\u0ab5\u0acb",button:"\u0aac\u0a9f\u0aa8","T&C_1":"\u0aaa\u0acd\u0ab0\u0aa5\u0aae \u0a8f\u0a9c\u0acd\u0aaf\u0ac1\u0a95\u0ac7\u0ab6\u0aa8 \u0aab\u0abe\u0a89\u0aa8\u0acd\u0aa1\u0ac7\u0ab6\u0aa8 (\u0aaa\u0acd\u0ab0\u0aa5\u0aae) \u0a8f \u0aad\u0abe\u0ab0\u0aa4\u0aa8\u0ac0 \u0ab8\u0acc\u0aa5\u0ac0 \u0aae\u0acb\u0a9f\u0ac0 \u0a8f\u0aa8\u0a9c\u0ac0\u0a93\u0aae\u0abe\u0a82\u0aa8\u0ac0 \u0a8f\u0a95 \u0a9b\u0ac7, \u0a9c\u0ac7\u0aa8\u0ac0 \u0ab0\u0a9c\u0abf\u0ab8\u0acd\u0a9f\u0ab0\u0acd\u0aa1 \u0a93\u0aab\u0abf\u0ab8 \u0aae\u0ac1\u0a82\u0aac\u0a88\u0aae\u0abe\u0a82 \u0a9b\u0ac7. \u0aaa\u0acd\u0ab0\u0aa5\u0aae\u0ac7 25 \u0ab5\u0ab0\u0acd\u0ab7\u0aa5\u0ac0 \u0ab5\u0aa7\u0ac1 \u0ab8\u0aae\u0aaf\u0aa5\u0ac0 \u0ab6\u0abf\u0a95\u0acd\u0ab7\u0aa3 \u0a95\u0acd\u0ab7\u0ac7\u0aa4\u0acd\u0ab0\u0ac7 \u0a95\u0abe\u0aae \u0a95\u0ab0\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7.","T&C_2":"\u0aa4\u0aae\u0ac7 \u0a9c\u0abe\u0aa3\u0acb \u0a9b\u0acb \u0aa4\u0ac7\u0aae, \u0aa4\u0aae\u0ac7 \u0aaa\u0acd\u0ab0\u0aa5\u0aae \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a86\u0aaf\u0acb\u0a9c\u0abf\u0aa4 \u0aaa\u0acd\u0ab0\u0ab5\u0ac3\u0aa4\u0acd\u0aa4\u0abf\u0a93\u0aae\u0abe\u0a82 \u0aad\u0abe\u0a97 \u0ab2\u0a88 \u0ab0\u0ab9\u0acd\u0aaf\u0abe \u0a9b\u0acb. \u0a86 \u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad\u0ac7, \u0aaa\u0acd\u0ab0\u0aa5\u0aae \u0aa4\u0ac7\u0aa8\u0abe \u0ab8\u0acd\u0ab5\u0aaf\u0a82\u0ab8\u0ac7\u0ab5\u0a95\u0acb/\u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0aa8\u0abf\u0aa7\u0abf\u0a93 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa4\u0aae\u0abe\u0ab0\u0acb \u0aa1\u0ac7\u0a9f\u0abe \u0a8f\u0a95\u0aa4\u0acd\u0ab0\u0abf\u0aa4 \u0a95\u0ab0\u0ab6\u0ac7, \u0a9c\u0ac7\u0aae\u0abe\u0a82 \u0aaa\u0acd\u0ab0\u0ab5\u0ac3\u0aa4\u0acd\u0aa4\u0abf\u0a93\u0aae\u0abe\u0a82 \u0aad\u0abe\u0a97 \u0ab2\u0ac7\u0aa4\u0ac0 \u0ab5\u0a96\u0aa4\u0ac7 \u0aae\u0ac2\u0ab3\u0aad\u0ac2\u0aa4 \u0a93\u0ab3\u0a96, \u0ab8\u0acd\u0aa5\u0abe\u0aa8, \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0aae\u0abe\u0a9f\u0ac7\u0aa8\u0ac0 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0, \u0ab6\u0ac0\u0a96\u0ab5\u0abe \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aa1\u0ac7\u0a9f\u0abe, \u0a9a\u0abf\u0aa4\u0acd\u0ab0\u0acb/\u0aab\u0acb\u0a9f\u0acb\u0a97\u0acd\u0ab0\u0abe\u0aab\u0acd\u0ab8, \u0ab5\u0abf\u0aa1\u0abf\u0aaf\u0acb, \u0ab5\u0ac9\u0a87\u0ab8 \u0ab0\u0ac7\u0a95\u0acb\u0ab0\u0acd\u0aa1\u0abf\u0a82\u0a97\u0acd\u0ab8 (\u2018\u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u2019) \u0ab6\u0abe\u0aae\u0ac7\u0ab2 \u0a9b\u0ac7, \u0aaa\u0ab0\u0a82\u0aa4\u0ac1 \u0aa4\u0ac7 \u0a86\u0a9f\u0ab2\u0ac1\u0a82 \u0a9c \u0aae\u0ab0\u0acd\u0aaf\u0abe\u0aa6\u0abf\u0aa4 \u0aa8\u0aa5\u0ac0.","T&C_3":"\u0a8f\u0a95\u0aa4\u0acd\u0ab0\u0abf\u0aa4 \u0a95\u0ab0\u0ac7\u0ab2\u0ac0 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0/\u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0 \u0aa8\u0ac0\u0a9a\u0ac7\u0aa8\u0abe \u0ab9\u0ac7\u0aa4\u0ac1\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0a86\u0a82\u0ab6\u0abf\u0a95 \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0a82\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0ab0\u0ac0\u0aa4\u0ac7 \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0ac7:","T&C_4":"1. \u0a95\u0abe\u0ab0\u0acd\u0aaf\u0a95\u0acd\u0ab0\u0aae \u0a85\u0aae\u0ab2\u0ac0\u0a95\u0ab0\u0aa3 \u0a85\u0aa8\u0ac7 \u0ab8\u0ac1\u0aa7\u0abe\u0ab0\u0aa3\u0abe, \u0ab8\u0aae\u0ac1\u0aa6\u0abe\u0aaf \u0ab8\u0ab9\u0aad\u0abe\u0a97\u0abf\u0aa4\u0abe, \u0a85\u0aa8\u0ac7 \u0ab0\u0abf\u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0abf\u0a82\u0a97 \u0ab9\u0ac7\u0aa4\u0ac1\u0a93.","T&C_5":"2. \u0aaa\u0acd\u0ab0\u0aa5\u0aae\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab6\u0aa8\u0acb\u0aae\u0abe\u0a82, \u0aa1\u0acb\u0aa8\u0ab0 \u0ab0\u0abf\u0aaa\u0acb\u0ab0\u0acd\u0a9f (\u0aad\u0abe\u0ab0\u0aa4\u0aae\u0abe\u0a82 \u0aa4\u0ac7\u0aae\u0a9c \u0a86\u0a82\u0aa4\u0ab0\u0ab0\u0abe\u0ab7\u0acd\u0a9f\u0acd\u0ab0\u0ac0\u0aaf \u0ab8\u0acd\u0aa4\u0ab0\u0ac7), \u0aae\u0ac0\u0aa1\u0abf\u0aaf\u0abe \u0aaa\u0acd\u0ab0\u0ab5\u0ac3\u0aa4\u0acd\u0aa4\u0abf\u0a93\u0aae\u0abe\u0a82, \u0ab8\u0acb\u0ab6\u0abf\u0aaf\u0ab2 \u0aae\u0ac0\u0aa1\u0abf\u0aaf\u0abe \u0aaa\u0acd\u0ab0\u0ab5\u0ac3\u0aa4\u0acd\u0aa4\u0abf\u0a93\u0aae\u0abe\u0a82 (\u0aa6\u0abe.\u0aa4.: \u0aab\u0ac7\u0ab8\u0aac\u0ac1\u0a95, \u0aaf\u0ac2\u0a9f\u0acd\u0aaf\u0ac2\u0aac, \u0a87\u0aa8\u0acd\u0ab8\u0acd\u0a9f\u0abe\u0a97\u0acd\u0ab0\u0abe\u0aae, \u0ab2\u0abf\u0a82\u0a95\u0acd\u0aa1\u0a87\u0aa8, \u0a9f\u0acd\u0ab5\u0abf\u0a9f\u0ab0, \u0aa5\u0acd\u0ab0\u0ac7\u0aa1\u0acd\u0ab8 \u0ab5\u0a97\u0ac7\u0ab0\u0ac7), \u0aa1\u0abf\u0a9c\u0abf\u0a9f\u0ab2 \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae \u0aaa\u0ab0\u0aa8\u0ac0 \u0aaa\u0acd\u0ab0\u0ab5\u0ac3\u0aa4\u0acd\u0aa4\u0abf\u0a93\u0aae\u0abe\u0a82 (\u0aa6\u0abe.\u0aa4.: \u0aaa\u0acd\u0ab0\u0aa5\u0aae\u0aa8\u0ac0 \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f\u0acd\u0ab8). \u0a86 \u0ab6\u0ac8\u0a95\u0acd\u0ab7\u0aa3\u0abf\u0a95 \u0aaa\u0acd\u0ab0\u0ab5\u0ac3\u0aa4\u0acd\u0aa4\u0abf\u0a93 \u0ab5\u0abf\u0ab6\u0ac7 \u0a9c\u0abe\u0a97\u0ac3\u0aa4\u0abf \u0aab\u0ac7\u0ab2\u0abe\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0ac7.","T&C_6":"3. \u0ae9. \u0aaa\u0acd\u0ab0\u0aa5\u0aae\u0aa8\u0abe \u0a95\u0abe\u0ab0\u0acd\u0aaf \u0ab5\u0abf\u0ab6\u0ac7 \u0a9c\u0abe\u0a97\u0ac3\u0aa4\u0abf \u0aab\u0ac7\u0ab2\u0abe\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa1\u0acb\u0aa8\u0ab0 (\u0aad\u0abe\u0ab0\u0aa4 \u0aa4\u0ac7\u0aae\u0a9c \u0a86\u0a82\u0aa4\u0ab0\u0ab0\u0abe\u0ab7\u0acd\u0a9f\u0acd\u0ab0\u0ac0\u0aaf \u0ab8\u0acd\u0aa4\u0ab0\u0ac7) \u0ab8\u0abe\u0aa5\u0ac7 \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0ab5\u0abe.","T&C_7":"\u0a89\u0aaa\u0ab0\u0acb\u0a95\u0acd\u0aa4 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0/\u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0 \u0a8f\u0a95\u0aa4\u0acd\u0ab0\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe, \u0ab8\u0a82\u0a97\u0acd\u0ab0\u0ab9 \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0aa8\u0ac7 \u0ab5\u0abe\u0aaa\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0a82\u0aae\u0aa4\u0abf \u0a86\u0aaa\u0ab5\u0abe \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7. \u0a9c\u0acb \u0a95\u0ac7, \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0ab5\u0abf\u0ab5\u0ac7\u0a95\u0aac\u0ac1\u0aa6\u0acd\u0aa7\u0abf \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac7, \u0aa4\u0aae\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0/\u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u0aa8\u0abe \u0ab8\u0a82\u0a97\u0acd\u0ab0\u0ab9 \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0a82\u0aae\u0aa4\u0abf \u0aa8\u0a95\u0abe\u0ab0\u0ac0  \u0ab6\u0a95\u0acb \u0a9b\u0acb.","T&C_8":"\u0ab9\u0ac1\u0a82 \u0aaa\u0acd\u0ab0\u0aa5\u0aae, \u0aa4\u0ac7\u0aa8\u0abe \u0ab8\u0acd\u0ab5\u0aaf\u0a82\u0ab8\u0ac7\u0ab5\u0a95\u0acb \u0a85\u0aa8\u0ac7/\u0a85\u0aa5\u0ab5\u0abe \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0aa8\u0abf\u0aa7\u0abf\u0a93\u0aa8\u0ac7 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0aa6\u0aac\u0abe\u0aa3 \u0ab5\u0abf\u0aa8\u0abe \u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0abe\u0aa5\u0ac7 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0a89\u0aaa\u0ab0\u0acb\u0a95\u0acd\u0aa4 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97, \u0ab8\u0a82\u0a97\u0acd\u0ab0\u0ab9, \u0ab6\u0ac7\u0ab0\u0abf\u0a82\u0a97 \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab6\u0aa8 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0a82\u0aae\u0aa4\u0abf \u0a86\u0aaa\u0ac1\u0a82 \u0a9b\u0ac1\u0a82.","T&C_9":"\u0a9c\u0acb \u0ab9\u0ac1\u0a82 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0ab8\u0aae\u0aaf\u0ac7 \u0aae\u0abe\u0ab0\u0acb \u0aa1\u0ac7\u0a9f\u0abe/\u0aab\u0acb\u0a9f\u0acb/\u0ab5\u0abf\u0aa1\u0abf\u0aaf\u0acb \u0aaa\u0acd\u0ab0\u0aa5\u0aae\u0aa8\u0ac0 \u0ab5\u0ac7\u0aac\u0ab8\u0abe\u0a87\u0a9f \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0acd\u0a9f\u0acb\u0ab0\u0ac7\u0a9c \u0aaa\u0acd\u0ab2\u0ac7\u0a9f\u0aab\u0acb\u0ab0\u0acd\u0aae\u0acd\u0ab8\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aa6\u0ac2\u0ab0 \u0a95\u0ab0\u0ab5\u0abe, \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0ac1\u0aa7\u0abe\u0ab0\u0ab5\u0abe \u0aa8\u0a95\u0acd\u0a95\u0ac0 \u0a95\u0ab0\u0ac1\u0a82, \u0aa4\u0acb \u0ab9\u0ac1\u0a82 \u0aab\u0acb\u0aa8/\u0a87\u0aae\u0ac7\u0a87\u0ab2 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aaa\u0acd\u0ab0\u0aa5\u0aae\u0aa8\u0abe \u0ab8\u0acd\u0ab5\u0aaf\u0a82\u0ab8\u0ac7\u0ab5\u0a95/\u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0aa8\u0abf\u0aa7\u0abf\u0aa8\u0acb \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0a95\u0ab0\u0ac0\u0ab6, \u0a9c\u0ac7 \u0ab2\u0ac7\u0a96\u0abf\u0aa4 \u0a89\u0aaa\u0ab8\u0a82\u0ab9\u0abe\u0ab0/\u0ab8\u0a82\u0aae\u0aa4\u0abf \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a85\u0aa8\u0ac1\u0ab8\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7. \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0aac\u0abe\u0aa6, \u0aaa\u0acd\u0ab0\u0aa5\u0aae, \u0aa4\u0ac7\u0aa8\u0abe \u0ab8\u0acd\u0ab5\u0aaf\u0a82\u0ab8\u0ac7\u0ab5\u0a95\u0acb \u0a85\u0aa8\u0ac7/\u0a85\u0aa5\u0ab5\u0abe \u0aaa\u0acd\u0ab0\u0aa4\u0abf\u0aa8\u0abf\u0aa7\u0abf\u0a93 15 \u0a95\u0abe\u0aae\u0a95\u0abe\u0a9c\u0aa8\u0abe \u0aa6\u0abf\u0ab5\u0ab8\u0acb\u0aae\u0abe\u0a82 \u0aa4\u0ac7\u0aa8\u0ac7 \u0aa6\u0ac2\u0ab0 \u0a95\u0ab0\u0ab6\u0ac7 \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0ac1\u0aa7\u0abe\u0ab0\u0ab6\u0ac7/\u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab6\u0ac7. \u0a86 \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aa8\u0ac0\u0a9a\u0ac7 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7.","T&C_10":"\u0aae\u0ac7\u0a82 \u0a89\u0aaa\u0ab0\u0acb\u0a95\u0acd\u0aa4 \u0ab5\u0abe\u0a82\u0a9a\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7/\u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0acd\u0aa5\u0abe\u0aa8\u0abf\u0a95 \u0aad\u0abe\u0ab7\u0abe\u0aae\u0abe\u0a82 \u0aae\u0aa8\u0ac7 \u0ab8\u0aae\u0a9c\u0abe\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0a85\u0ab9\u0ac0\u0a82\u0aa8\u0ac0 \u0ab6\u0ab0\u0aa4\u0acb\u0aa8\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0 \u0ab8\u0a82\u0aaa\u0ac2\u0ab0\u0acd\u0aa3\u0aaa\u0aa3\u0ac7 \u0ab8\u0aae\u0a9c\u0ac0 \u0a9b\u0ac7. \u0ab9\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0/\u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0\u0aa8\u0abe \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0aae\u0abe\u0a9f\u0ac7 \u0a89\u0aaa\u0ab0\u0acb\u0a95\u0acd\u0aa4 \u0ab6\u0ab0\u0aa4\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0a82\u0aae\u0aa4\u0abf\u0aa8\u0ac0 \u0aaa\u0ac1\u0ab7\u0acd\u0a9f\u0abf \u0a95\u0ab0\u0ac1\u0a82 \u0a9b\u0ac1\u0a82 \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aa8\u0abe \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0ac7 \u0a95\u0acb\u0a88 \u0aa6\u0abe\u0ab5\u0acb \u0aa8\u0ab9\u0ac0\u0a82 \u0a95\u0ab0\u0ac1\u0a82.","T&C_11":"\u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0ab5\u0abf\u0a97\u0aa4\u0acb: \u0aaa\u0acd\u0ab0\u0aa5\u0aae \u0a8f\u0a9c\u0acd\u0aaf\u0ac1\u0a95\u0ac7\u0ab6\u0aa8 \u0aab\u0abe\u0a89\u0aa8\u0acd\u0aa1\u0ac7\u0ab6\u0aa8",office_adrress:"\u0aa6\u0abf\u0ab2\u0acd\u0ab9\u0ac0 \u0a93\u0aab\u0abf\u0ab8: B4/59, \u0ab8\u0aab\u0aa6\u0ab0\u0a9c\u0a82\u0a97 \u0a8f\u0aa8\u0acd\u0a95\u0acd\u0ab2\u0ac7\u0ab5, \u0aa8\u0ab5\u0ac0 \u0aa6\u0abf\u0ab2\u0acd\u0ab9\u0ac0-110029",office_email:"\u0a87\u0aae\u0ac7\u0a87\u0ab2: dataprotectionofficer@pratham.org",office_phone:"\u0aab\u0acb\u0aa8 \u0aa8\u0a82: 011-26177200",office_website:"| www.pratham.org |",office_cin:"CIN: U80101MH2002NPL136300","T&C_12":"\u0aae\u0ac7\u0a82 \u0a97\u0acb\u0aaa\u0aa8\u0ac0\u0aaf\u0aa4\u0abe \u0aa8\u0ac0\u0aa4\u0abf \u0ab5\u0abe\u0a82\u0a9a\u0ac0 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0abe\u0ab0\u0ac1\u0a82 \u0a9b\u0ac1\u0a82 \u0a85\u0aa8\u0ac7 \u0ab8\u0a82\u0aae\u0aa4\u0abf \u0aab\u0acb\u0ab0\u0acd\u0aae\u0aae\u0abe\u0a82 \u0ab5\u0ab0\u0acd\u0aa3\u0ab5\u0acd\u0aaf\u0abe \u0aae\u0ac1\u0a9c\u0aac \u0aae\u0abe\u0ab0\u0abe \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0aa1\u0ac7\u0a9f\u0abe\u0aa8\u0abe \u0ab8\u0a82\u0a97\u0acd\u0ab0\u0ab9 \u0a85\u0aa8\u0ac7 \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0a82\u0aae\u0aa4\u0abf \u0a86\u0aaa\u0ac1\u0a82 \u0a9b\u0ac1\u0a82.","T&C_13":"\u0aa4\u0aae\u0ac7 \u0aaa\u0acd\u0ab0\u0acb\u0aab\u0abe\u0a87\u0ab2 \u0aaa\u0ac7\u0a9c \u0aaa\u0ab0\u0aa8\u0abe '\u0aa1\u0ac7\u0a9f\u0abe \u0a85\u0aa8\u0ac7 \u0a97\u0acb\u0aaa\u0aa8\u0ac0\u0aaf\u0aa4\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0'\u0aae\u0abe\u0a82 \u0a86\u0aaa\u0ac7\u0ab2\u0abe \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0ab5\u0abf\u0a97\u0aa4\u0acb\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0ab8\u0aae\u0aaf\u0ac7 \u0aa1\u0ac7\u0a9f\u0abe \u0aa6\u0ac2\u0ab0 \u0a95\u0ab0\u0ab5\u0abe, \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0aa5\u0ab5\u0abe \u0aab\u0ac7\u0ab0\u0aab\u0abe\u0ab0\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb.",username_already_exists:"\u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe \u0aa8\u0abe\u0aae \u0aaa\u0ab9\u0ac7\u0ab2\u0ac7\u0aa5\u0ac0 \u0a9c \u0a85\u0ab8\u0acd\u0aa4\u0abf\u0aa4\u0acd\u0ab5\u0aae\u0abe\u0a82 \u0a9b\u0ac7",username_is_already_exists_in_keycloak:"\u0ab5\u0aaa\u0ab0\u0abe\u0ab6\u0a95\u0ab0\u0acd\u0aa4\u0abe \u0aa8\u0abe\u0aae \u0aaa\u0ab9\u0ac7\u0ab2\u0ac7\u0aa5\u0ac0 \u0a9c \u0a85\u0ab8\u0acd\u0aa4\u0abf\u0aa4\u0acd\u0ab5\u0aae\u0abe\u0a82 \u0a9b\u0ac7",something_went_wrong_try_again_later:"\u0a95\u0a82\u0a88\u0a95 \u0a96\u0acb\u0a9f\u0ac1\u0a82 \u0aa5\u0aaf\u0ac1\u0a82, \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aaa\u0a9b\u0ac0\u0aa5\u0ac0 \u0aab\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0aaf\u0abe\u0ab8 \u0a95\u0ab0\u0acb.",Learning_Content:"\u0ab6\u0ac0\u0a96\u0ab5\u0abe\u0aa8\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0",Update_your_preferences_to_get_the_best_picks_just_for_you:"\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab6\u0acd\u0ab0\u0ac7\u0ab7\u0acd\u0aa0 \u0aaa\u0ab8\u0a82\u0aa6\u0a97\u0ac0\u0a93 \u0aae\u0ac7\u0ab3\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0ab8\u0a82\u0aa6\u0a97\u0ac0\u0a93 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0acb!",Based_on_Your_Interests:"\u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0ab0\u0ac1\u0a9a\u0abf\u0a93\u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0ac7",view_all:"\u0aac\u0aa7\u0ac1\u0a82 \u0a9c\u0ac1\u0a93",Financial_Literacy:"\u0aa8\u0abe\u0aa3\u0abe\u0a95\u0ac0\u0aaf \u0ab8\u0abe\u0a95\u0acd\u0ab7\u0ab0\u0aa4\u0abe",Continue_Learning:"\u0a85\u0aad\u0acd\u0aaf\u0abe\u0ab8 \u0a9a\u0abe\u0ab2\u0ac1 \u0ab0\u0abe\u0a96\u0acb",Preferences:"\u0aaa\u0ab8\u0a82\u0aa6\u0a97\u0ac0\u0a93",Food_Production:"\u0a96\u0abe\u0aa6\u0acd\u0aaf \u0a89\u0aa4\u0acd\u0aaa\u0abe\u0aa6\u0aa8",Conceptual_Thinking:"\u0aa7\u0abe\u0ab0\u0aa3\u0abe\u0aa4\u0acd\u0aae\u0a95 \u0ab5\u0abf\u0a9a\u0abe\u0ab0\u0ab5\u0abf\u0aae\u0ab0\u0acd\u0ab6",Todays_Top_Pick:"\u0a86\u0a9c\u0aa8\u0acb \u0ab6\u0acd\u0ab0\u0ac7\u0ab7\u0acd\u0aa0 \u0ab5\u0abf\u0a95\u0ab2\u0acd\u0aaa",Art:"\u0a95\u0ab2\u0abe",Assessments:"\u0aae\u0ac1\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8",assessment:"\u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8","pre-test":"\u0aaa\u0acd\u0ab0\u0abf-\u0a9f\u0ac7\u0ab8\u0acd\u0a9f","post-test":"\u0aaa\u0acb\u0ab8\u0acd\u0a9f-\u0a9f\u0ac7\u0ab8\u0acd\u0a9f",Inprogress:"\u0a9a\u0abe\u0ab2\u0ac1 \u0a9b\u0ac7",Overallscore:"\u0a95\u0ac1\u0ab2 \u0ab8\u0acd\u0a95\u0acb\u0ab0",completed:"\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0aa5\u0aaf\u0ac1\u0a82",take_the_test:"\u0a9f\u0ac7\u0ab8\u0acd\u0a9f\u0aa8\u0ac0 \u0ab6\u0ab0\u0ac2\u0a86\u0aa4 \u0a95\u0ab0\u0acb",not_started:"\u0ab6\u0ab0\u0ac2\u0a86\u0aa4 \u0a95\u0ab0\u0ac0 \u0aa8\u0aa5\u0ac0",submitted_On:"\u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0abe\u0aaf\u0ac1\u0a82 \u0aaa\u0ab0 :",reading:"\u0ab5\u0abe\u0a82\u0a9a\u0aa8",out_of:"\u0aae\u0abe\u0a9f\u0ac7",correct_answers:"\u0ab8\u0abe\u0a9a\u0abe \u0a9c\u0ab5\u0abe\u0aac",assessment_note:"\u0a9f\u0abf\u0aaa\u0acd\u0aaa\u0aa3\u0ac0: \u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0aaa\u0acd\u0ab0\u0abf-\u0a9f\u0ac7\u0ab8\u0acd\u0a9f \u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aae\u0abe\u0aa8\u0acd\u0aaf \u0ab0\u0ab9\u0ac7\u0ab6\u0ac7 \u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aa4\u0aae\u0ac7 \u0aa4\u0aae\u0abe\u0aae \u0ab5\u0abf\u0ab7\u0aaf\u0acb \u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0a95\u0ab0\u0acb \u0a9b\u0acb.",assessment_instructions:"\u0aa8\u0ac0\u0a9a\u0ac7 \u0a86\u0aaa\u0ac7\u0ab2\u0abe \u0aa6\u0ab0\u0ac7\u0a95 \u0ab5\u0abf\u0ab7\u0aaf \u0aae\u0abe\u0a9f\u0ac7 \u0a9f\u0ac7\u0ab8\u0acd\u0a9f \u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0a95\u0ab0\u0acb. \u0aa4\u0ac7\u0aae\u0aa8\u0ac7 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a95\u0acd\u0ab0\u0aae\u0aae\u0abe\u0a82 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa8\u0abf\u0a83\u0ab8\u0a82\u0a95\u0acb\u0a9a \u0ab0\u0ab9\u0acb.",instruction1:"\u0ab8\u0aae\u0aaf\u0a95\u0abe\u0ab3: \u0a86 \u0aaa\u0ab0\u0ac0\u0a95\u0acd\u0ab7\u0abe \u0aae\u0ab0\u0acd\u0aaf\u0abe\u0aa6\u0abf\u0aa4 \u0ab8\u0aae\u0aaf\u0aa8\u0ac0 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 20 \u0aae\u0abf\u0aa8\u0abf\u0a9f \u0ab8\u0ac1\u0aa7\u0ac0 \u0a9a\u0abe\u0ab2\u0ab6\u0ac7. \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab8\u0aae\u0aaf\u0aa8\u0ac1\u0a82 \u0ab8\u0a82\u0a9a\u0abe\u0ab2\u0aa8 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0ab0\u0ac0\u0aa4\u0ac7 \u0a95\u0ab0\u0acb.",instruction2:"\u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb\u0aa8\u0ac0 \u0ab8\u0a82\u0a96\u0acd\u0aaf\u0abe: \u0a86 \u0aaa\u0ab0\u0ac0\u0a95\u0acd\u0ab7\u0abe\u0aae\u0abe\u0a82 \u0aac\u0ab9\u0ac1\u0ab5\u0abf\u0a95\u0ab2\u0acd\u0aaa\u0ac0 \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb \u0a9b\u0ac7. \u0aac\u0aa7\u0abe \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb \u0a86\u0aaa\u0ac7\u0ab2\u0abe \u0ab8\u0aae\u0aaf\u0aae\u0abe\u0a82 \u0a9c\u0ab5\u0abe\u0aac \u0a86\u0aaa\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0ab8\u0ac1\u0aa8\u0abf\u0ab6\u0acd\u0a9a\u0abf\u0aa4 \u0a95\u0ab0\u0acb.",instruction3:"\u0ab8\u0aac\u0aae\u0abf\u0ab6\u0aa8: \u0aa4\u0aae\u0ac7 \u0aaa\u0ab0\u0ac0\u0a95\u0acd\u0ab7\u0abe \u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0a8f\u0a95\u0ab5\u0abe\u0ab0 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb. \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0aa4\u0abe \u0aaa\u0ab9\u0ac7\u0ab2\u0abe \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a9c\u0ab5\u0abe\u0aac\u0acb \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0a9a\u0a95\u0abe\u0ab8\u0acb, \u0a95\u0abe\u0ab0\u0aa3 \u0a95\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac7 \u0aaa\u0ac1\u0aa8\u0a83\u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0a95\u0acb\u0a88 \u0aa4\u0a95 \u0aae\u0ab3\u0ab6\u0ac7 \u0aa8\u0ab9\u0ac0\u0a82.",instruction4:"\u0a9f\u0ac7\u0ab8\u0acd\u0a9f \u0ab6\u0ab0\u0ac2 \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0abe \u0a9b\u0ac0\u0a8f: \u0a96\u0abe\u0aa4\u0ab0\u0ac0 \u0a95\u0ab0\u0acb \u0a95\u0ac7 \u0aa4\u0aae\u0ac7 \u0a95\u0acb\u0a88 \u0ab5\u0abf\u0a95\u0acd\u0ab7\u0ac7\u0aaa \u0ab5\u0abf\u0aa8\u0abe \u0ab6\u0abe\u0a82\u0aa4 \u0ab5\u0abe\u0aa4\u0abe\u0ab5\u0ab0\u0aa3\u0aae\u0abe\u0a82 \u0a9b\u0acb. \u0a96\u0abe\u0aa4\u0ab0\u0ac0 \u0a95\u0ab0\u0acb \u0a95\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0a87\u0aa8\u0acd\u0a9f\u0ab0\u0aa8\u0ac7\u0a9f \u0a95\u0aa8\u0ac7\u0a95\u0acd\u0ab6\u0aa8 \u0ab8\u0acd\u0aa5\u0abf\u0ab0 \u0a9b\u0ac7.",instruction5:"\u0aaa\u0ab0\u0ac0\u0a95\u0acd\u0ab7\u0abe\u0a