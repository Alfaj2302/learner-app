c\u062a\u06d2 \u0648\u0642\u062a \u0628\u0646\u06cc\u0627\u062f\u06cc \u0634\u0646\u0627\u062e\u062a\u060c \u0645\u0642\u0627\u0645\u060c \u0631\u0627\u0628\u0637\u06c1 \u06a9\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u060c \u0633\u06cc\u06a9\u06be\u0646\u06d2 \u0633\u06d2 \u0645\u062a\u0639\u0644\u0642 \u0688\u06cc\u0679\u0627\u060c \u062a\u0635\u0627\u0648\u06cc\u0631/\u0641\u0648\u0679\u0648 \u06af\u0631\u0627\u0641\u0633\u060c \u0648\u06cc\u0688\u06cc\u0648\u0632\u060c \u0622\u0648\u0627\u0632 \u06a9\u06cc \u0631\u06cc\u06a9\u0627\u0631\u0688\u0646\u06af\u0632 (\u2018\u0645\u0648\u0627\u062f\u2019) \u0634\u0627\u0645\u0644 \u06c1\u06cc\u06ba\u060c \u0644\u06cc\u06a9\u0646 \u06cc\u06c1 \u0635\u0631\u0641 \u0627\u0646 \u062a\u06a9 \u0645\u062d\u062f\u0648\u062f \u0646\u06c1\u06cc\u06ba \u06c1\u06cc\u06ba\u06d4","T&C_3":"\u062c\u0645\u0639 \u06a9\u0631\u062f\u06c1 \u0645\u0639\u0644\u0648\u0645\u0627\u062a/\u0645\u0648\u0627\u062f \u06a9\u0648 \u062f\u0631\u062c \u0630\u06cc\u0644 \u0645\u0642\u0627\u0635\u062f \u06a9\u06d2 \u0644\u06cc\u06d2 \u062c\u0632\u0648\u06cc \u06cc\u0627 \u0645\u06a9\u0645\u0644 \u0637\u0648\u0631 \u067e\u0631 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627:","T&C_4":"1. \u067e\u0631\u0648\u06af\u0631\u0627\u0645 \u06a9\u06d2 \u0646\u0641\u0627\u0630 \u0627\u0648\u0631 \u0628\u06c1\u062a\u0631\u06cc\u060c \u06a9\u0645\u06cc\u0648\u0646\u0679\u06cc \u06a9\u06cc \u0634\u0631\u06a9\u062a\u060c \u0627\u0648\u0631 \u0631\u067e\u0648\u0631\u0679\u0646\u06af \u06a9\u06d2 \u0645\u0642\u0627\u0635\u062f\u06d4","T&C_5":"2. \u067e\u0631\u062a\u06be\u0645 \u06a9\u06d2 \u0627\u0634\u0627\u0639\u062a\u06cc \u0645\u0648\u0627\u062f \u0645\u06cc\u06ba\u060c \u0688\u0648\u0646\u0631 \u0631\u067e\u0648\u0631\u0679\u0633 \u0645\u06cc\u06ba (\u0628\u06be\u0627\u0631\u062a \u0627\u0648\u0631 \u0628\u06cc\u0646 \u0627\u0644\u0627\u0642\u0648\u0627\u0645\u06cc \u0633\u0637\u062d \u067e\u0631)\u060c \u0645\u06cc\u0688\u06cc\u0627 \u0633\u0631\u06af\u0631\u0645\u06cc\u0648\u06ba \u0645\u06cc\u06ba\u060c \u0633\u0648\u0634\u0644 \u0645\u06cc\u0688\u06cc\u0627 \u0633\u0631\u06af\u0631\u0645\u06cc\u0648\u06ba \u0645\u06cc\u06ba (\u0645\u062b\u0627\u0644 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631: \u0641\u06cc\u0633 \u0628\u06a9\u060c \u06cc\u0648\u0679\u06cc\u0648\u0628\u060c \u0627\u0646\u0633\u0679\u0627\u06af\u0631\u0627\u0645\u060c \u0644\u0646\u06a9\u0688 \u0627\u0646\u060c \u0679\u0648\u0626\u0679\u0631\u060c \u062a\u06be\u0631\u06cc\u0688\u0632 \u0648\u063a\u06cc\u0631\u06c1)\u060c \u0688\u06cc\u062c\u06cc\u0679\u0644 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0632 \u067e\u0631 \u0633\u0631\u06af\u0631\u0645\u06cc\u0648\u06ba \u0645\u06cc\u06ba (\u0645\u062b\u0627\u0644 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631: \u067e\u0631\u062a\u06be\u0645 \u06a9\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679\u0633)\u06d4 \u06cc\u06c1 \u062a\u0639\u0644\u06cc\u0645\u06cc \u0633\u0631\u06af\u0631\u0645\u06cc\u0648\u06ba \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u0622\u06af\u0627\u06c1\u06cc \u067e\u06be\u06cc\u0644\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06c1\u0648\u06ba \u06af\u06d2\u06d4","T&C_6":"3. \u067e\u0631\u062a\u06be\u0645 \u06a9\u06d2 \u0639\u0637\u06cc\u0627\u062a\u06cc \u06a9\u0627\u0645 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u0622\u06af\u0627\u06c1\u06cc \u067e\u06be\u06cc\u0644\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0688\u0648\u0646\u0631\u0632 \u06a9\u06d2 \u0633\u0627\u062a\u06be (\u0628\u06be\u0627\u0631\u062a \u0627\u0648\u0631 \u0628\u06cc\u0646 \u0627\u0644\u0627\u0642\u0648\u0627\u0645\u06cc \u0633\u0637\u062d \u067e\u0631) \u0627\u0634\u062a\u0631\u0627\u06a9 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u06d4","T&C_7":"\u06c1\u0645 \u0622\u067e \u0633\u06d2 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0645\u0630\u06a9\u0648\u0631\u06c1 \u0628\u0627\u0644\u0627 \u0645\u0639\u0644\u0648\u0645\u0627\u062a/\u0645\u0648\u0627\u062f \u06a9\u0648 \u062c\u0645\u0639 \u06a9\u0631\u0646\u06d2\u060c \u0630\u062e\u06cc\u0631\u06c1 \u06a9\u0631\u0646\u06d2 \u0627\u0648\u0631 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u062f\u06cc\u06ba\u06d4 \u062a\u0627\u06c1\u0645\u060c \u0622\u067e \u0627\u067e\u0646\u06cc \u0635\u0648\u0627\u0628\u062f\u06cc\u062f \u067e\u0631\u060c \u0627\u067e\u0646\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a/\u0645\u0648\u0627\u062f \u06a9\u06d2 \u062c\u0645\u0639 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u0633\u06d2 \u0627\u0646\u06a9\u0627\u0631 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4","T&C_8":"\u0645\u06cc\u06ba \u067e\u0631\u062a\u06be\u0645\u060c \u0627\u0633 \u06a9\u06d2 \u0631\u0636\u0627\u06a9\u0627\u0631\u0648\u06ba \u0627\u0648\u0631/\u06cc\u0627 \u0646\u0645\u0627\u0626\u0646\u062f\u0648\u06ba \u06a9\u0648 \u0628\u063a\u06cc\u0631 \u06a9\u0633\u06cc \u062f\u0628\u0627\u0624 \u06a9\u06d2 \u0645\u06cc\u0631\u06d2 \u0633\u0627\u062a\u06be \u0645\u062a\u0639\u0644\u0642\u06c1 \u0645\u0630\u06a9\u0648\u0631\u06c1 \u0628\u0627\u0644\u0627 \u0645\u0648\u0627\u062f \u06a9\u0648 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u06d2\u060c \u0630\u062e\u06cc\u0631\u06c1 \u06a9\u0631\u0646\u06d2\u060c \u0627\u0634\u062a\u0631\u0627\u06a9 \u06a9\u0631\u0646\u06d2\u060c \u0627\u0648\u0631 \u0634\u0627\u0626\u0639 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u062f\u06cc\u062a\u0627 \u06c1\u0648\u06ba\u06d4","T&C_9":"\u0627\u06af\u0631 \u0645\u06cc\u06ba \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0648\u0642\u062a \u0627\u067e\u0646\u0627 \u0688\u06cc\u0679\u0627/\u062a\u0635\u0648\u06cc\u0631/\u0648\u06cc\u0688\u06cc\u0648 \u067e\u0631\u062a\u06be\u0645 \u06a9\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679 \u06cc\u0627 \u0627\u0633\u0679\u0648\u0631\u06cc\u062c \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645\u0632 \u0633\u06d2 \u06c1\u0679\u0627\u0646\u06d2\u060c \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u06d2 \u06cc\u0627 \u062a\u0631\u0645\u06cc\u0645 \u06a9\u0631\u0646\u06d2 \u06a9\u0627 \u0641\u06cc\u0635\u0644\u06c1 \u06a9\u0631\u062a\u0627 \u06c1\u0648\u06ba\u060c \u062a\u0648 \u0645\u06cc\u06ba \u0641\u0648\u0646/\u0627\u06cc \u0645\u06cc\u0644 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u067e\u0631\u062a\u06be\u0645 \u06a9\u06d2 \u0631\u0636\u0627\u06a9\u0627\u0631/\u0646\u0645\u0627\u0626\u0646\u062f\u06d2 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u0648\u06ba \u06af\u0627\u060c \u062c\u0633 \u06a9\u06d2 \u0628\u0639\u062f \u062a\u062d\u0631\u06cc\u0631\u06cc \u0648\u0627\u067e\u0633\u06cc/\u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u06a9\u06cc \u062a\u062c\u062f\u06cc\u062f \u06c1\u0648 \u0633\u06a9\u062a\u06cc \u06c1\u06d2\u06d4 \u0627\u0633 \u06a9\u06d2 \u0628\u0639\u062f\u060c \u067e\u0631\u062a\u06be\u0645\u060c \u0627\u0633 \u06a9\u06d2 \u0631\u0636\u0627\u06a9\u0627\u0631 \u0627\u0648\u0631/\u06cc\u0627 \u0646\u0645\u0627\u0626\u0646\u062f\u06d2 15 \u06a9\u0627\u0645 \u06a9\u06d2 \u062f\u0646\u0648\u06ba \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u0627\u0633\u06d2 \u06c1\u0679\u0627\u0626\u06cc\u06ba \u06af\u06d2 \u06cc\u0627 \u062a\u0631\u0645\u06cc\u0645/\u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u06cc\u06ba \u06af\u06d2\u06d4 \u0627\u0633 \u0633\u0644\u0633\u0644\u06d2 \u0645\u06cc\u06ba \u0631\u0627\u0628\u0637\u06c1 \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0646\u06cc\u0686\u06d2 \u062f\u06cc \u06af\u0626\u06cc \u06c1\u06cc\u06ba\u06d4","T&C_10":"\u0645\u06cc\u06ba \u0646\u06d2 \u0645\u0630\u06a9\u0648\u0631\u06c1 \u0628\u0627\u0644\u0627 \u06a9\u0648 \u067e\u0691\u06be\u0627 \u0627\u0648\u0631/\u06cc\u0627 \u0645\u0642\u0627\u0645\u06cc \u0632\u0628\u0627\u0646 \u0645\u06cc\u06ba \u0633\u0645\u062c\u06be\u0627\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u06cc\u06c1\u0627\u06ba \u06a9\u06cc \u0634\u0631\u0627\u0626\u0637 \u06a9\u06d2 \u0645\u0648\u0627\u062f \u06a9\u0648 \u0645\u06a9\u0645\u0644 \u0637\u0648\u0631 \u067e\u0631 \u0633\u0645\u062c\u06be\u0627 \u06c1\u06d2\u06d4 \u0645\u06cc\u06ba \u0627\u067e\u0646\u06d2 \u0645\u0648\u0627\u062f/\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u0630\u06a9\u0648\u0631\u06c1 \u0628\u0627\u0644\u0627 \u0634\u0631\u0627\u0626\u0637 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u067e\u0646\u06cc \u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u06a9\u06cc \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u062a\u0627 \u06c1\u0648\u06ba \u0627\u0648\u0631 \u0627\u0633 \u06a9\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06d2 \u0633\u0644\u0633\u0644\u06d2 \u0645\u06cc\u06ba \u06a9\u0648\u0626\u06cc \u062f\u0639\u0648\u06cc\u0670 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u0648\u06ba \u06af\u0627\u06d4","T&C_11":"\u0631\u0627\u0628\u0637\u06c1 \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a: \u067e\u0631\u062a\u06be\u0645 \u0627\u06cc\u062c\u0648\u06a9\u06cc\u0634\u0646 \u0641\u0627\u0624\u0646\u0688\u06cc\u0634\u0646",office_adrress:"\u062f\u06c1\u0644\u06cc \u062f\u0641\u062a\u0631: B4/59\u060c \u0635\u0641\u062f\u0631\u062c\u0646\u06af \u0627\u0646\u06a9\u0644\u06cc\u0648\u060c \u0646\u0626\u06cc \u062f\u06c1\u0644\u06cc-110029",office_email:"\u0627\u06cc \u0645\u06cc\u0644: dataprotectionofficer@pratham.org",office_phone:"\u0641\u0648\u0646 \u0646\u0645\u0628\u0631: 011-26177200",office_website:"| www.pratham.org |",office_cin:"CIN: U80101MH2002NPL136300","T&C_12":"\u0645\u06cc\u06ba \u0646\u06d2 \u0631\u0627\u0632\u062f\u0627\u0631\u06cc \u06a9\u06cc \u067e\u0627\u0644\u06cc\u0633\u06cc \u067e\u0691\u06be\u06cc \u0627\u0648\u0631 \u0642\u0628\u0648\u0644 \u06a9\u06cc \u06c1\u06d2 \u0627\u0648\u0631 \u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u0641\u0627\u0631\u0645 \u0645\u06cc\u06ba \u0628\u06cc\u0627\u0646 \u06a9\u0631\u062f\u06c1 \u0645\u0637\u0627\u0628\u0642 \u0627\u067e\u0646\u06d2 \u0630\u0627\u062a\u06cc \u0688\u06cc\u0679\u0627 \u06a9\u06d2 \u062c\u0645\u0639 \u06a9\u0631\u0646\u06d2 \u0627\u0648\u0631 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u062f\u06cc\u062a\u0627 \u06c1\u0648\u06ba\u06d4","T&C_13":"\u0622\u067e \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u0635\u0641\u062d\u06c1 \u067e\u0631 '\u0688\u06cc\u0679\u0627 \u0627\u0648\u0631 \u0631\u0627\u0632\u062f\u0627\u0631\u06cc \u0645\u0631\u06a9\u0632' \u0645\u06cc\u06ba \u062f\u06cc\u06d2 \u06af\u0626\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0633\u06d2 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0648\u0642\u062a \u0688\u06cc\u0679\u0627 \u06c1\u0679\u0627\u0646\u06d2\u060c \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631\u0646\u06d2 \u06cc\u0627 \u062a\u0628\u062f\u06cc\u0644\u06cc\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",username_already_exists:"\u0635\u0627\u0631\u0641 \u0646\u0627\u0645 \u067e\u06c1\u0644\u06d2 \u0633\u06d2 \u0645\u0648\u062c\u0648\u062f \u06c1\u06d2",username_is_already_exists_in_keycloak:"\u0635\u0627\u0631\u0641 \u0646\u0627\u0645 \u067e\u06c1\u0644\u06d2 \u0633\u06d2 \u0645\u0648\u062c\u0648\u062f \u06c1\u06d2",something_went_wrong_try_again_later:"\u06a9\u0686\u06be \u063a\u0644\u0637 \u06c1\u0648 \u06af\u06cc\u0627\u060c \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0628\u0639\u062f \u0645\u06cc\u06ba \u062f\u0648\u0628\u0627\u0631\u06c1 \u06a9\u0648\u0634\u0634 \u06a9\u0631\u06cc\u06ba\u06d4",Learning_Content:"\u0633\u06cc\u06a9\u06be\u0646\u06d2 \u06a9\u0627 \u0645\u0648\u0627\u062f",