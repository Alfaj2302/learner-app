\u0908\u0921\u0940",individual_volunteer:"\u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 (\u0907\u0902\u0921\u093f\u0935\u093f\u091c\u0941\u0905\u0932) \u0935\u0949\u0932\u0902\u091f\u093f\u092f\u0930",individual_volunteer_through_an_organisation:"\u0938\u0902\u0917\u0920\u0928 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 (\u0907\u0902\u0921\u093f\u0935\u093f\u091c\u0941\u0905\u0932) \u0935\u0949\u0932\u0902\u091f\u093f\u092f\u0930",register_an_organisation_as_poc:"\u0938\u0902\u0917\u0920\u0928 (\u0938\u0902\u0938\u094d\u0925\u093e) \u0915\u094b POC \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0930\u091c\u093f\u0938\u094d\u091f\u0930 \u0915\u0930\u0947\u0902",update_available:"\u0905\u092a\u0921\u0947\u091f \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948",update_available_message:"\u0910\u092a \u0915\u093e \u0928\u092f\u093e \u0935\u0930\u094d\u091c\u093c\u0928 ({latestVersion}) \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0964 \u0928\u090f \u092b\u0940\u091a\u0930\u094d\u0938 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902\u0964",error_catch:"\u0924\u094d\u0930\u0941\u091f\u093f \u092a\u0915\u0921\u093c\u0940 \u0917\u0908 / \u0924\u094d\u0930\u0941\u091f\u093f \u0939\u0941\u0908",invalid_file_title:"\u0905\u092e\u093e\u0928\u094d\u092f \u092b\u093e\u0907\u0932",failed_to_create_file:"\u092b\u093e\u0907\u0932 \u092c\u0928 \u0928\u0939\u0940\u0902 \u0938\u0915\u0940",failed_to_download_file:"\u092b\u093e\u0907\u0932 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0940",applied_filters:"\u0932\u0917\u093e\u090f \u0917\u090f \u092b\u093c\u093f\u0932\u094d\u091f\u0930:",search_placeholder:"\u0916\u094b\u091c\u0947\u0902...",one_image_uploaded:"1 \u0924\u0938\u094d\u0935\u0940\u0930 \u0905\u