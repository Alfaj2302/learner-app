OUT_REASON:"\u0938\u094d\u0915\u0942\u0932 \u091b\u094b\u0921\u093c\u0928\u0947 \u0915\u093e \u0915\u093e\u0930\u0923",self_employment_own_business_shop:"\u0938\u094d\u0935\u0930\u094b\u091c\u0917\u093e\u0930, \u0938\u094d\u0935\u092f\u0902 \u0915\u093e \u0935\u094d\u092f\u0935\u0938\u093e\u092f \u092f\u093e \u0926\u0941\u0915\u093e\u0928",student:"\u091b\u093e\u0924\u094d\u0930",grade_1:"\u0915\u0915\u094d\u0937\u093e 1",grade_2:"\u0915\u0915\u094d\u0937\u093e 2",grade_3:"\u0915\u0915\u094d\u0937\u093e 3",grade_4:"\u0915\u0915\u094d\u0937\u093e 4",grade_5:"\u0915\u0915\u094d\u0937\u093e 5",grade_6:"\u0915\u0915\u094d\u0937\u093e 6",grade_7:"\u0915\u0915\u094d\u0937\u093e 7",grade_8:"\u0915\u0915\u094d\u0937\u093e 8",grade_9:"\u0915\u0915\u094d\u0937\u093e 9",grade_10:"\u0915\u0915\u094d\u0937\u093e 10",grade_11:"\u0915\u0915\u094d\u0937\u093e 11",grade_12:"\u0915\u0915\u094d\u0937\u093e 12",spouse_name:"\u092a\u0924\u093f/\u092a\u0924\u094d\u0928\u0940 \u0915\u093e \u0928\u093e\u092e",father_name:"\u092a\u093f\u0924\u093e \u0915\u093e \u0928\u093e\u092e",nophone:"\u092b\u094b\u0928 \u0928\u0939\u0940\u0902","###ATM###":"###ATM###",online_assessment:"\u0911\u0928\u0932\u093e\u0907\u0928 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928",offline_assessment:"\u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928",Total_Assessment:"\u0915\u0941\u0932 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928",Total_Assessments:"\u0915\u0941\u0932 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928",no_offline_assessments_available:"\u0915\u094b\u0908 \u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948",no_online_assessments_available:"\u0915\u094b\u0908 \u0911\u0928\u0932\u093e\u0907\u0928 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948",not_submitted:"\u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0917\u092f\u093e",submitted_eval:"\u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e",published_on:"\u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e",clear_filter:"\u092b\u093c\u093f\u0932\u094d\u091f\u0930 \u0938\u093e\u092b\u093c \u0915\u0930\u0947\u0902",Explanation:"\u0935\u094d\u092f\u093e\u0916\u094d\u092f\u093e","See less":"\u0915\u092e \u0926\u0947\u0916\u0947\u0902","See more":"\u0905\u0927\u093f\u0915 \u0926\u0947\u0916\u0947\u0902",Marks:"\u0905\u0902\u0915","Approve Marks & Notify Learner":"\u0905\u0902\u0915 \u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0936\u093f\u0915\u094d\u0937\u093e\u0930\u094d\u0925\u0940 \u0915\u094b \u0938\u0942\u091a\u093f\u0924 \u0915\u0930\u0947\u0902","Fill in the Blanks":"\u0930\u093f\u0915\u094d\u0924 \u0938\u094d\u0925\u093e\u0928 \u092d\u0930\u0947\u0902","Multiple Choice Questions":"\u092c\u0939\u0941\u0935\u093f\u0915\u0932\u094d\u092a\u0940\u092f \u092a\u094d\u0930\u0936\u094d\u0928","Short Answer Questions":"\u0932\u0918\u0941 \u0909\u0924\u094d\u0924\u0930\u0940\u092f \u092a\u094d\u0930\u0936\u094d\u0928","Long Answer Questions":"\u0926\u0940\u0930\u094d\u0918 \u0909\u0924\u094d\u0924\u0930\u0940\u092f \u092a\u094d\u0930\u0936\u094d\u0928","Unknown Section":"\u0905\u091c\u094d\u091e\u093e\u0924 \u0916\u0902\u0921","No assessment data available":"\u0915\u094b\u0908 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0921\u0947\u091f\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948","Please check if the assessment has been completed and try again":"\u0915\u0943\u092a\u092f\u093e \u091c\u093e\u0901\u091a\u0947\u0902 \u0915\u093f \u0915\u094d\u092f\u093e \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u092a\u0942\u0930\u093e \u0939\u094b \u0917\u092f\u093e \u0939\u0948 \u0914\u0930 \u092b\u093f\u0930 \u0938\u0947 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902","AnswerSheet Component is Rendering":"\u0909\u0924\u094d\u0924\u0930 \u092a\u0924\u094d\u0930\u0915 \u0918\u091f\u0915 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0939\u094b \u0930\u0939\u093e \u0939\u0948","But no assessment data available":"\u0932\u0947\u0915\u093f\u0928 \u0915\u094b\u0908 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0921\u0947\u091f\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948","No Images Uploaded":"\u0915\u094b\u0908 \u092b\u093c\u094b\u091f\u094b \u0905\u092a\u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0917\u092f\u093e","Uploaded Images":"\u0905\u092a\u0932\u094b\u0921 \u0915\u0940 \u0917\u0908 \u092b\u093c\u094b\u091f\u094b","Remove Image":"\u091b\u0935\u093f \u092b\u093c\u094b\u091f\u094b \u0939\u091f\u093e\u090f\u0902","Are you sure you want to remove this image?":"\u0915\u094d\u092f\u093e \u0906\u092a \u0935\u093e\u0915\u0908 \u0907\u0938 \u092b\u093c\u094b\u091f\u094b \u0915\u094b \u0939\u091f\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?","Selected Images":"\u091a\u092f\u0928\u093f\u0924 \u092b\u093c\u094b\u091f\u094b",images:"\u092b\u093c\u094b\u091f\u094b","You have selected":"\u0906\u092a\u0928\u0947 \u091a\u092f\u0928 \u0915\u093f\u092f\u093e \u0939\u0948","For better performance, we recommend uploading up to 20 images at a time":"\u092c\u0947\u0939\u0924\u0930 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0915\u0947 \u0932\u093f\u090f, \u0939\u092e \u090f\u0915 \u092c\u093e\u0930 \u092e\u0947\u0902 \u0905\u0927\u093f\u0915\u0924\u092e 20 \u092b\u093c\u094b\u091f\u094b \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0938\u0932\u093e\u0939 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902","Add More Images":"\u0914\u0930 \u092b\u093c\u094b\u091f\u094b \u0921\u093e\u0932\u0947\u0902","No images uploaded":"\u0915\u094b\u0908 \u092b\u093c\u094b\u091f\u094b \u0905\u092a\u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0917\u092f\u093e","Images Selected":"\u092b\u093c\u094b\u091f\u094b \u091a\u0941\u0928 \u0932\u093f\u090f \u0917\u090f",Recommended:"\u0905\u0928\u0941\u0936\u0902\u0938\u093f\u0924","Submit Answers for AI Evaluation":"\u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0915\u0947 \u0932\u093f\u090f \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0947\u0902","Take Photo":"\u092b\u093c\u094b\u091f\u094b \u0932\u0947\u0902","Choose from Gallery":"\u0917\u0948\u0932\u0930\u0940 \u0938\u0947 \u091a\u0941\u0928\u0947\u0902","Format: jpg, size: 50 MB":"\u092a\u094d\u0930\u093e\u0930\u0942\u092a: jpg, \u0906\u0915\u093e\u0930: 50 MB","Up to 20 images":"\u0905\u0927\u093f\u0915\u0924\u092e 20 \u092b\u093c\u094b\u091f\u094b","Exam Instructions":"\u092a\u0930\u0940\u0915\u094d\u0937\u093e \u0928\u093f\u0930\u094d\u0926\u0947\u0936","Re-verify the image after selection. Once submitted for evaluation, it cannot be resubmitted.":"\u091a\u092f\u0928 \u0915\u0947 \u092c\u093e\u0926 \u092b\u093c\u094b\u091f\u094b \u0915\u094b \u092a\u0941\u0928\u0903 \u091c\u093e\u0901\u091a \u0932\u0947\u0902\u0964 \u090f\u0915 \u092c\u093e\u0930 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0939\u0947\u0924\u0941 \u091c\u092e\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u0907\u0938\u0947 \u0926\u094b\u092c\u093e\u0930\u093e \u091c\u092e\u093e \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e\u0964","Take a plain white paper":"\u090f\u0915 \u0938\u093e\u0926\u093e \u0938\u092b\u093c\u0947\u0926 \u0915\u093e\u0917\u091c\u093c \u0932\u0947\u0902","Use pen with black or blue ink only":"\u0915\u0947\u0935\u0932 \u0915\u093e\u0932\u0947 \u092f\u093e \u0928\u0940\u0932\u0947 \u0938\u094d\u092f\u093e\u0939\u0940 \u0935\u093e\u0932\u093e \u092a\u0947\u0928 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902","Write all the answers, including MCQs and fill-in-the-blanks, on the piece of paper":"\u0938\u092d\u0940 \u0909\u0924\u094d\u0924\u0930, MCQs \u0914\u0930 \u0930\u093f\u0915\u094d\u0924 \u0938\u094d\u0925\u093e\u0928 \u092d\u0930\u0928\u0947 \u0938\u0939\u093f\u0924, \u0915\u093e\u0917\u091c \u0915\u0947 \u091f\u0941\u0915\u0921\u093c\u0947 \u092a\u0930 \u0932\u093f\u0916\u0947\u0902\n\n\u0938\u092d\u0940 \u0909\u0924\u094d\u0924\u0930, \u092c\u0939\u0941\u0935\u093f\u0915\u0932\u094d\u092a\u0940\u092f \u092a\u094d\u0930\u0936\u094d\u0928 \u0914\u0930 \u0930\u093f\u0915\u094d\u0924 \u0938\u094d\u0925\u093e\u0928, \u0915\u093e\u0917\u091c\u093c \u090f\u0915 \u091f\u0941\u0915\u0921\u093c\u0947 \u092a\u0930 \u0932\u093f\u0916\u0947\u0902","Use the same numbering system as the question paper; take extra care to write the numbers clearly":"\u092a\u094d\u0930\u0936\u094d\u0928 \u092a\u0924\u094d\u0930 \u0915\u0947 \u0938\u092e\u093e\u0928 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u0928 \u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902; \u0938\u0902\u0916\u094d\u092f\u093e\u0913\u0902 \u0915\u094b \u0938\u094d\u092a\u0937\u094d\u091f \u0930\u0942\u092a \u0938\u0947 \u0932\u093f\u0916\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u0936\u0947\u0937 \u0938\u093e\u0935\u0927\u093e\u0928\u0940 \u092c\u0930\u0924\u0947\u0902","Write clearly and make sure the letters do not touch the edges of the page. If a mistake is made, strike it out neatly and write it again":"\u0938\u094d\u092a\u0937\u094d\u091f \u0930\u0942\u092a \u0938\u0947 \u0932\u093f\u0916\u0947\u0902 \u0914\u0930 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0905\u0915\u094d\u0937\u0930 \u092a\u0943\u0937\u094d\u0920 \u0915\u0947 \u0915\u093f\u0928\u093e\u0930\u094b\u0902 \u0915\u094b \u0928 \u091b\u0942\u090f\u0902\u0964 \u092f\u0926\u093f \u0915\u094b\u0908 \u0917\u093c\u0932\u0924\u0940 \u0939\u094b \u091c\u093e\u090f, \u0924\u094b \u0909\u0938\u0947 \u0938\u093e\u092b\u093c \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0915\u093e\u091f \u0926\u0947\u0902 \u0914\u0930 \u092b\u093f\u0930 \u0938\u0947 \u0932\u093f\u0916\u0947\u0902","Processing...":"\u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0930 \u0930\u0939\u093e \u0939\u0948...","Processing images...":"\u092b\u093c\u094b\u091f\u094b \u092a\u0930 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0930 \u0930\u0939\u093e \u0939\u0948...","We recommend uploading up to 20 images":"\u0939\u092e \u0905\u0927\u093f\u0915\u0924\u092e 20 \u092b\u093c\u094b\u091f\u094b \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0938\u0932\u093e\u0939 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902","Submit for Review":"\u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0947\u0902",Uploading:"\u0905\u092a\u0932\u094b\u0921 \u0939\u094b \u0930\u0939\u093e \u0939\u0948","Uploading Files":"\u092b\u093e\u0907\u0932\u0947\u0902 \u0905\u092a\u0932\u094b\u0921 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948\u0902","Images are successfully uploaded":"\u092b\u093c\u094b\u091f\u094b \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0905\u092a\u0932\u094b\u0921 \u0939\u094b \u0917\u090f \u0939\u0948\u0902","Failed to upload images. Please try again.":"\u092b\u093c\u094b\u091f\u094b \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964","No Images":"\u0915\u094b\u0908\u092b\u093c\u094b\u091f\u094b \u0928\u0939\u0940\u0902","Please select images to upload.":"\u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092b\u093c\u094b\u091f\u094b \u091a\u0941\u0928\u0947\u0902\u0964",Error:"\u0924\u094d\u0930\u0941\u091f\u093f","Failed to capture photo. Please try again.":"\u092b\u093c\u094b\u091f\u094b \u0932\u0947\u0928\u093e \u0935\u093f\u092b\u0932\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964","Failed to select images. Please try again.":"\u092b\u093c\u094b\u091f\u094b \u091a\u0941\u0928\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964","Your answers have been successfully submitted for evaluation":"\u0906\u092a\u0915\u0947 \u0909\u0924\u094d\u0924\u0930 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0915\u0947 \u0932\u093f\u090f \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930 \u0926\u093f\u090f \u0917\u090f \u0939\u0948\u0902","You'll be notified as soon as the evaluation is complete.":"\u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u092a\u0942\u0930\u093e \u0939\u094b\u0924\u0947 \u0939\u0940 \u0906\u092a\u0915\u094b \u0938\u0942\u091a\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964","In the meantime, make sure you've submitted all required answers correctly. If you face any issues, please reach out to your facilitator.":"\u0907\u0938 \u092c\u0940\u091a, \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0906\u092a\u0928\u0947 \u0938\u092d\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0909\u0924\u094d\u0924\u0930 \u0938\u0939\u0940 \u0922\u0902\u0917 \u0938\u0947 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u093f\u090f \u0939\u0948\u0902\u0964 \u092f\u0926\u093f \u0906\u092a\u0915\u094b \u0915\u094b\u0908 \u0938\u092e\u0938\u094d\u092f\u093e \u0906\u0924\u0940 \u0939\u0948, \u0924\u094b \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0947 \u0938\u0941\u0935\u093f\u0927\u093e\u0915\u0930\u094d\u0924\u093e \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0964","Loading assessment data...":"\u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0921\u0947\u091f\u093e \u0932\u094b\u0921 \u0939\u094b \u0930\u0939\u093e \u0939\u0948...","No assessment data available yet":"\u0905\u092d\u0940 \u0924\u0915 \u0915\u094b\u0908 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0921\u0947\u091f\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948",Image:"\u092b\u093c\u094b\u091f\u094b","Images Uploaded":"\u092b\u093c\u094b\u091f\u094b \u0905\u092a\u0932\u094b\u0921 \u0939\u094b \u0917\u090f","Permission Test Component":"\u0905\u0928\u0941\u092e\u0924\u093f \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0918\u091f\u0915","Check Permissions":"\u0905\u0928\u0941\u092e\u0924\u093f\u092f\u093e\u0901 \u091c\u093e\u0901\u091a\u0947\u0902","Request Permissions":"\u0905\u0928\u0941\u092e\u0924\u093f\u092f\u093e\u0901 \u092e\u093e\u0901\u0917\u0947\u0902","Permission Status":"\u0905\u0928\u0941\u092e\u0924\u093f \u0938\u094d\u0925\u093f\u0924\u093f","Permission Request Result":"\u0905\u0928\u0941\u092e\u0924\u093f \u0905\u0928\u0941\u0930\u094b\u0927 \u092a\u0930\u093f\u0923\u093e\u092e",Granted:"\u0938\u094d\u0935\u0940\u0915\u0943\u0924",Denied:"\u0905\u0938\u094d\u0935\u0940\u0915\u0943\u0924","Failed to check permissions":"\u0905\u0928\u0941\u092e\u0924\u093f\u092f\u093e\u0901 \u091c\u093e\u0901\u091a\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932","Failed to request permissions":"\u0905\u0928\u0941\u092e\u0924\u093f\u092f\u093e\u0901 \u092e\u093e\u0901\u0917\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932",OK:"\u0920\u0940\u0915 \u0939\u0948",confirm:"\u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902",delete_item:"\u0906\u0907\u091f\u092e \u0939\u091f\u093e\u090f\u0901",are_you_sure_you_want_to_delete_this_item:"\u0915\u094d\u092f\u093e \u0906\u092a \u0935\u093e\u0915\u0908 \u0907\u0938 \u0906\u0907\u091f\u092e \u0915\u094b \u0939\u091f\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?",success:"\u0938\u092b\u0932\u0924\u093e",error:"\u0924\u094d\u0930\u0941\u091f\u093f",warning:"\u091a\u0947\u0924\u093e\u0935\u0928\u0940","###DOWNLOAD###":"###DOWNLOAD###",download:"\u0921\u093e\u0909\u0928\u0932\u094b\u0921",downloading:"\u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0939\u094b \u0930\u0939\u093e \u0939\u0948",download_complete:"\u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u092a\u0942\u0930\u093e",download_failed:"\u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0935\u093f\u092b\u0932",download_starting:"\u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0936\u0941\u0930\u0942 \u0939\u094b \u0930\u0939\u093e \u0939\u0948... \u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902\u0964",download_success_message:"\u091b\u0935\u093f \u092b\u093c\u094b\u091f\u094b Downloads/LearnerApp \u092e\u0947\u0902 \u0938\u0939\u0947\u091c\u0940 \u0917\u0908 \u0938\u0939\u0947\u091c\u093e \u0917\u092f\u093e",download_failed_message:"\u091b\u0935\u093f \u092b\u093c\u094b\u091f\u094b \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u093e \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0901\u091a\u0947\u0902 \u0914\u0930 \u092b\u093f\u0930 \u0938\u0947 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",no_image_url:"\u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u091b\u0935\u093f \u0915\u093f\u09