\u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u0627 \u06af\u06cc\u0627\u06d4",submitted_eval:"\u062a\u0634\u062e\u06cc\u0635 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062c\u0645\u0639 \u06a9\u0631\u0627\u06cc\u0627",published_on:"\u0634\u0627\u0626\u0639 \u06c1\u0648\u0627\u06d4",clear_filter:"\u0641\u0644\u0679\u0631 \u0635\u0627\u0641 \u06a9\u0631\u06cc\u06ba\u06d4",Explanation:"\u0648\u0636\u0627\u062d\u062a","See less":"\u06a9\u0645 \u062f\u06cc\u06a9\u06be\u06cc\u06ba","See more":"\u0645\u0632\u06cc\u062f \u062f\u06cc\u06a9\u06be\u06cc\u06ba",Marks:"\u0646\u0634\u0627\u0646\u0627\u062a","Approve Marks & Notify Learner":"\u0645\u0627\u0631\u06a9\u0633 \u06a9\u0648 \u0645\u0646\u0638\u0648\u0631 \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \u0644\u0631\u0646\u0631 \u06a9\u0648 \u0645\u0637\u0644\u0639 \u06a9\u0631\u06cc\u06ba\u06d4","Fill in the Blanks":"\u062e\u0627\u0644\u06cc \u062c\u06af\u06c1\u0648\u06ba \u06a9\u0648 \u067e\u0631 \u06a9\u0631\u06cc\u06ba\u06d4","Multiple Choice Questions":"\u0645\u062a\u0639\u062f\u062f \u0627\u0646\u062a\u062e\u0627\u0628\u06cc \u0633\u0648\u0627\u0644\u0627\u062a","Short Answer Questions":"\u0645\u062e\u062a\u0635\u0631 \u062c\u0648\u0627\u0628\u0627\u062a \u06a9\u06d2 \u0633\u0648\u0627\u0644\u0627\u062a","Long Answer Questions":"\u0637\u0648\u06cc\u0644 \u062c\u0648\u0627\u0628\u0627\u062a \u0648\u0627\u0644\u06d2 \u0633\u0648\u0627\u0644\u0627\u062a","Unknown Section":"\u0646\u0627\u0645\u0639\u0644\u0648\u0645 \u0633\u06cc\u06a9\u0634\u0646","No assessment data available":"\u06a9\u0648\u0626\u06cc \u062a\u0634\u062e\u06cc\u0635\u06cc \u0688\u06cc\u0679\u0627 \u062f\u0633\u062a\u06cc\u0627\u0628 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4","Please check if the assessment has been completed and try again":"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba \u06a9\u06c1 \u0622\u06cc\u0627 \u062a\u0634\u062e\u06cc\u0635 \u0645\u06a9\u0645\u0644 \u06c1\u0648 \u06af\u06cc\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u062f\u0648\u0628\u0627\u0631\u06c1 \u06a9\u0648\u0634\u0634 \u06a9\u0631\u06cc\u06ba\u06d4","AnswerSheet Component is Rendering":"\u062c\u0648\u0627\u0628 \u0634\u06cc\u0679 \u06a9\u0627 \u062c\u0632\u0648 \u0631\u06cc\u0646\u0688\u0631\u0646\u06af \u06a9\u0631 \u0631\u06c1\u0627 \u06c1\u06d2\u06d4","But no assessment data available":"\u0644\u06cc\u06a9\u0646 \u06a9\u0648\u0626\u06cc \u062a\u0634\u062e\u06cc\u0635\u06cc \u0688\u06cc\u0679\u0627 \u062f\u0633\u062a\u06cc\u0627\u0628 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4","No Images Uploaded":"\u06a9\u0648\u0626\u06cc \u062a\u0635\u0648\u06cc\u0631\u06cc\u06ba \u0627\u067e \u0644\u0648\u0688 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u0626\u06cc\u06ba","Uploaded Images":"\u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u062f\u06c1 \u062a\u0635\u0627\u0648\u06cc\u0631","Remove Image":"\u062a\u0635\u0648\u06cc\u0631 \u06a9\u0648 \u06c1\u0679\u0627 \u062f\u06cc\u06ba\u06d4","Are you sure you want to remove this image?":"\u06a9\u06cc\u0627 \u0622\u067e \u0648\u0627\u0642\u0639\u06cc \u0627\u0633 \u062a\u0635\u0648\u06cc\u0631 \u06a9\u0648 \u06c1\u0679\u0627\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u061f","Selected Images":"\u0645\u0646\u062a\u062e\u0628 \u062a\u0635\u0627\u0648\u06cc\u0631",images:"\u062a\u0635\u0627\u0648\u06cc\u0631","You have selected":"\u0622\u067e \u0646\u06d2 \u0645\u0646\u062a\u062e\u0628 \u06a9\u06cc\u0627 \u06c1\u06d2\u06d4","For better performance, we recommend uploading up to 20 images at a time":"\u0628\u06c1\u062a\u0631 \u06a9\u0627\u0631\u06a9\u0631\u062f\u06af\u06cc \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u06c1\u0645 \u0627\u06cc\u06a9 \u0648\u0642\u062a \u0645\u06cc\u06ba 20 \u062a\u0635\u0627\u0648\u06cc\u0631 \u062a\u06a9 \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u062a\u062c\u0648\u06cc\u0632 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4","Add More Images":"\u0645\u0632\u06cc\u062f \u062a\u0635\u0627\u0648\u06cc\u0631 \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba\u06d4","No images uploaded":"\u06a9\u0648\u0626\u06cc \u062a\u0635\u0648\u06cc\u0631 \u0627\u067e \u0644\u0648\u0688 \u0646\u06c1\u06cc\u06ba \u06a9\u06cc \u06af\u0626\u06cc\u06d4","Images Selected":"\u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u062f\u06c1 \u062a\u0635\u0627\u0648\u06cc\u0631",Recommended:"\u062a\u062c\u0648\u06cc\u0632 \u06a9\u0631\u062f\u06c1","Submit Answers for AI Evaluation":"\u062a\u0634\u062e\u06cc\u0635 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062c\u0648\u0627\u0628\u0627\u062a \u062c\u0645\u0639 \u06a9\u0631\u0648\u0627\u0626\u06cc\u06ba\u06d4","Take Photo":"\u062a\u0635\u0648\u06cc\u0631 \u06a9\u06be\u06cc\u0646\u0686\u06cc\u06ba","Choose from Gallery":"\u06af\u06cc\u0644\u0631\u06cc \u0633\u06d2 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u06cc\u06ba\u06d4","Format: jpg, size: 50 MB":"\u0641\u0627\u0631\u0645\u06cc\u0679: jpg\u060c \u0633\u0627\u0626\u0632: 50 MB","Up to 20 images":"20 \u062a\u0635\u0627\u0648\u06cc\u0631 \u062a\u06a9","Exam Instructions":"\u0627\u0645\u062a\u062d\u0627\u0646 \u06a9\u06cc \u06c1\u062f\u0627\u06cc\u0627\u062a","Re-verify the image after selection. Once submitted for evaluation, it cannot be resubmitted.":"\u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u06d2 \u0628\u0639\u062f \u062a\u0635\u0648\u06cc\u0631 \u06a9\u06cc \u062f\u0648\u0628\u0627\u0631\u06c1 \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u06cc\u06ba\u06d4 \u0627\u06cc\u06a9 \u0628\u0627\u0631 \u062c\u0627\u0646\u0686 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062c\u0645\u0639 \u06a9\u0631\u0627\u0626\u06d2 \u062c\u0627\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f\u060c \u0627\u0633\u06d2 \u062f\u0648\u0628\u0627\u0631\u06c1 \u062c\u0645\u0639 \u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627\u06d4","Take a plain white paper":"\u0627\u06cc\u06a9 \u0633\u0627\u062f\u06c1 \u0633\u0641\u06cc\u062f \u06a9\u0627\u063a\u0630 \u0644\u06cc\u06ba\u06d4","Use pen with black or blue ink only":"\u0642\u0644\u0645 \u0635\u0631\u0641 \u0633\u06cc\u0627\u06c1 \u06cc\u0627 \u0646\u06cc\u0644\u06cc \u0633\u06cc\u0627\u06c1\u06cc \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u06d4","Write all the answers, including MCQs and fill-in-the-blanks, on the piece of paper":"\u06a9\u0627\u063a\u0630 \u06a9\u06d2 \u0679\u06a9\u0691\u06d2 \u067e\u0631 MCQs \u0627\u0648\u0631 \u062e\u0627\u0644\u06cc \u062c\u06af\u06c1\u0648\u06ba \u0633\u0645\u06cc\u062a \u062a\u0645\u0627\u0645 \u062c\u0648\u0627\u0628\u0627\u062a \u0644\u06a9\u06be\u06cc\u06ba","Use the same numbering system as the question paper; take extra care to write the numbers clearly":"\u0648\u06c1\u06cc \u0646\u0645\u0628\u0631\u0646\u06af \u0633\u0633\u0679\u0645 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06cc\u06ba \u062c\u0648 \u0633\u0648\u0627\u0644\u06cc\u06c1 \u067e\u0631\u0686\u06c1 \u06c1\u06d2\u06d4 \u0646\u0645\u0628\u0631\u0648\u06ba \u06a9\u0648 \u0648\u0627\u0636\u062d \u0637\u0648\u0631 \u067e\u0631 \u0644\u06a9\u06be\u0646\u06d2 \u06a9\u0627 \u0632\u06cc\u0627\u062f\u06c1 \u062e\u06cc\u0627\u0644 \u0631\u06a9\u06be\u06cc\u06ba","Write clearly and make sure the letters do not touch the edges of the page. If a mistake is made, strike it out neatly and write it again":"\u0648\u0627\u0636\u062d \u0637\u0648\u0631 \u067e\u0631 \u0644\u06a9\u06be\u06cc\u06ba \u0627\u0648\u0631 \u06cc\u0642\u06cc\u0646\u06cc \u0628\u0646\u0627\u0626\u06cc\u06ba \u06a9\u06c1 \u062d\u0631\u0648\u0641 \u0635\u0641\u062d\u06c1 \u06a9\u06d2 \u06a9\u0646\u0627\u0631\u0648\u06ba \u06a9\u0648 \u0646\u06c1\u06cc\u06ba \u0686\u06be\u0648\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0627\u06af\u0631 \u06a9\u0648\u0626\u06cc \u063a\u0644\u0637\u06cc \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u062a\u0648 \u0627\u0633\u06d2 \u0635\u0627\u0641 \u0633\u062a\u06be\u0631\u0627 \u06a9\u0631 \u06a9\u06d2 \u062f\u0648\u0628\u0627\u0631\u06c1 \u0644\u06a9\u06be\u06cc\u06ba\u06d4","Processing...":"\u067e\u0631\u0648\u0633\u06cc\u0633\u0646\u06af...","Processing images...":"\u062a\u0635\u0627\u0648\u06cc\u0631 \u067e\u0631 \u06a9\u0627\u0631\u0631\u0648\u0627\u0626\u06cc \u06c1\u0648 \u0631\u06c1\u06cc \u06c1\u06d2...","We recommend uploading up to 20 images":"\u06c1\u0645 20 \u062a\u0635\u0627\u0648\u06cc\u0631 \u062a\u06a9 \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u062a\u062c\u0648\u06cc\u0632 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4","Submit for Review":"\u062c\u0627\u0626\u0632\u06c1 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062c\u0645\u0639 \u06a9\u0631\u0648\u0627\u0626\u06cc\u06ba\u06d4",Uploading:"\u0627\u067e \u0644\u0648\u0688 \u06c1\u0648 \u0631\u06c1\u0627 \u06c1\u06d2\u06d4","Uploading Files":"\u0641\u0627\u0626\u0644\u06cc\u06ba \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u0646\u0627","Images are successfully uploaded":"\u062a\u0635\u0627\u0648\u06cc\u0631 \u06a9\u0627\u0645\u06cc\u0627\u0628\u06cc \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0627\u067e \u0644\u0648\u0688 \u06c1\u0648 \u06af\u0626\u06cc \u06c1\u06cc\u06ba\u06d4","Failed to upload images. Please try again.":"\u062a\u0635\u0627\u0648\u06cc\u0631 \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u0646\u06d2 \u0645\u06cc\u06ba \u0646\u0627\u06a9\u0627\u0645\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u062f\u0648\u0628\u0627\u0631\u06c1 \u06a9\u0648\u0634\u0634 \u06a9\u0631\u06cc\u06ba\u06d4","No Images":"\u06a9\u0648\u0626\u06cc \u062a\u0635\u0627\u0648\u06cc\u0631 \u0646\u06c1\u06cc\u06ba\u06d4","Please select images to upload.":"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062a\u0635\u0627\u0648\u06cc\u0631 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4",Error:"\u062e\u0631\u0627\u0628\u06cc","Failed to capture photo. Please try again.":"\u062a\u0635\u0648\u06cc\u0631 \u06a9\u06cc\u067e\u0686\u0631 \u06a9\u0631\u0646\u06d2 \u0645\u06cc\u06ba \u0646\u0627\u06a9\u0627\u0645\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u062f\u0648\u0628\u0627\u0631\u06c1 \u06a9\u0648\u0634\u0634 \u06a9\u0631\u06cc\u06ba\u06d4","Failed to select images. Please try again.":"\u062a\u0635\u0627\u0648\u06cc\u0631 \u06a9\u0648 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u0646\u06d2 \u0645\u06cc\u06ba \u0646\u0627\u06a9\u0627\u0645\u06d4 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u062f\u0648\u0628\u0627\u0631\u06c1 \u06a9\u0648\u0634\u0634 \u06a9\u0631\u06cc\u06ba\u06d4","Your answers have been successfully submitted for evaluation":"\u0622\u067e \u06a9\u06d2 \u062c\u0648\u0627\u0628\u0627\u062a \u06a9\u0627\u0645\u06cc\u0627\u0628\u06cc \u06a9\u06d2 \u0633\u0627\u062a\u06be \u062c\u0627\u0646\u0686 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062c\u0645\u0639 \u06a9\u0631\u0627\u0626\u06d2 \u06af\u0626\u06d2 \u06c1\u06cc\u06ba\u06d4","You'll be notified as soon as the evaluation is complete.":"\u062a\u0634\u062e\u06cc\u0635 \u0645\u06a9\u0645\u0644 \u06c1\u0648\u062a\u06d2 \u06c1\u06cc \u0622\u067e \u06a9\u0648 \u0645\u0637\u0644\u0639 \u06a9\u0631 \u062f\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4","In the meantime, make sure you've submitted all required answers correctly. If you face any issues, please reach out to your facilitator.":"\u0627\u0633 \u062f\u0648\u0631\u0627\u0646\u060c \u06cc\u0642\u06cc\u0646\u06cc \u0628\u0646\u0627\u0626\u06cc\u06ba \u06a9\u06c1 \u0622\u067e \u0646\u06d2 \u062a\u0645\u0627\u0645 \u0645\u0637\u0644\u0648\u0628\u06c1 \u062c\u0648\u0627\u0628\u0627\u062a \u062f\u0631\u0633\u062a \u0637\u0631\u06cc\u0642\u06d2 \u0633\u06d2 \u062c\u0645\u0639 \u06a9\u0631\u0627\u0626\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0627\u06af\u0631 \u0622\u067e \u06a9\u0648 \u06a9\u0648\u0626\u06cc \u0645\u0633\u0626\u0644\u06c1 \u062f\u0631\u067e\u06cc\u0634 \u06c1\u06d2 \u062a\u0648 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u067e\u0646\u06d2 \u0633\u06c1\u0648\u0644\u062a \u06a9\u0627\u0631 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba\u06d4","Loading assessment data...":"\u062a\u0634\u062e\u06cc\u0635\u06cc \u0688\u06cc\u0679\u0627 \u0644\u0648\u0688 \u06c1\u0648 \u0631\u06c1\u0627 \u06c1\u06d2...","No assessment data available yet":"\u0627\u0628\u06be\u06cc \u062a\u06a9 \u06a9\u0648\u0626\u06cc \u062a\u0634\u062e\u06cc\u0635\u06cc \u0688\u06cc\u0679\u0627 \u062f\u0633\u062a\u06cc\u0627\u0628 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4",Image:"\u062a\u0635\u0648\u06cc\u0631","Images Uploaded":"\u062a\u0635\u0627\u0648\u06cc\u0631 \u0627\u067e \u0644\u0648\u0688 \u06a9\u06cc \u06af\u0626\u06cc\u06ba\u06d4","Permission Test Component":"\u0627\u062c\u0627\u0632\u062a \u0679\u06cc\u0633\u0679 \u06a9\u0627 \u062c\u0632\u0648","Check Permissions":"\u0627\u062c\u0627\u0632\u062a\u06cc\u06ba \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4","Request Permissions":"\u0627\u062c\u0627\u0632\u062a\u0648\u06ba \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0631\u06cc\u06ba\u06d4","Permission Status":"\u0627\u062c\u0627\u0632\u062a \u06a9\u06cc \u062d\u06cc\u062b\u06cc\u062a","Permission Request Result":"\u0627\u062c\u0627\u0632\u062a \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0627 \u0646\u062a\u06cc\u062c\u06c1",Granted:"\u0639\u0637\u0627 \u06a9\u06cc\u0627",Denied:"\u0627\u0646\u06a9\u0627\u0631 \u06a9\u0631 \u062f\u06cc\u0627\u06d4","Failed to check permissions":"\u0627\u062c\u0627\u0632\u062a\u06cc\u06ba \u0686\u06cc\u06a9 \u06a9\u0631\u0646\u06d2 \u0645\u06cc\u06ba \u0646\u0627\u06a9\u0627\u0645","Failed to request permissions":"\u0627\u062c\u0627\u0632\u062a\u0648\u06ba \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u0631\u0646\u06d2 \u0645\u06cc\u06ba \u0646\u0627\u06a9\u0627\u0645",OK:"\u0679\u06be\u06cc\u06a9 \u06c1\u06d2",confirm:"\u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u06cc\u06ba\u06d4",delete_item:"\u0622\u0626\u0679\u0645 \u06a9\u0648 \u062d\u0630\u0641 \u06a9\u0631\u06cc\u06ba\u06d4",ar