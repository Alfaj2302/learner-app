NICATION:"\u0995\u09be\u09b0\u09cd\u09af\u0995\u09b0 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997",q6_login_cred:"\u09b8\u09ac\u09b6\u09c7\u09b7\u09c7, \u0986\u09aa\u09a8\u09be\u09b0 \u09b2\u0997\u0987\u09a8 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09aa\u09a4\u09cd\u09b0 \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c1\u09a8",lb_username:"\u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0 \u09a8\u09be\u09ae \u0995\u09be\u09b8\u09cd\u099f\u09ae\u09be\u0987\u099c \u0995\u09b0\u09c1\u09a8",lb_username_info:"\u098f\u099f\u09bf \u09b2\u0997\u0987\u09a8 \u09b8\u09ae\u09af\u09bc \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u09b9\u09ac\u09c7",lb_username_error:"\u098f\u09ae\u09a8 \u098f\u0995\u099f\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0 \u09a8\u09be\u09ae \u0987\u09a4\u09bf\u09ae\u09a7\u09cd\u09af\u09c7\u0987 \u09ac\u09bf\u09a6\u09cd\u09af\u09ae\u09be\u09a8",lb_pass:"\u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1",confirm_password:"\u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09c1\u09a8",customize_dashboard_message:"\u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09cd\u09af\u09be\u09b6\u09ac\u09cb\u09b0\u09cd\u09a1 \u0995\u09be\u09b8\u09cd\u099f\u09ae\u09be\u0987\u099c \u0995\u09b0\u09be \u09b9\u099a\u09cd\u099b\u09c7..",login:"\u09b2\u0997\u0987\u09a8",content:"\u0995\u09a8\u099f\u09c7\u09a8\u09cd\u099f",courses:"\u0995\u09cb\u09b0\u09cd\u09b8",profile:"\u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2",usersname:"\u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0 \u09a8\u09be\u09ae \u0995\u09be\u09b8\u09cd\u099f\u09ae\u09be\u0987\u099c \u0995\u09b0\u09c1\u09a8",username:"\u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0 \u09a8\u09be\u09ae",password:"\u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1",forgot_password:"\u09aa\u09be\u09b8\u