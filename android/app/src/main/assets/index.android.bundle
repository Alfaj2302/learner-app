\u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u092a\u0939\u0941\u0902\u091a \u0915\u0947 \u0932\u093f\u090f \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0917\u092f\u093e",unsupported_content:"\u0905\u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0938\u093e\u092e\u0917\u094d\u0930\u0940",content_not_in_device:"\u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u092e\u094b\u0921 \u092e\u0947\u0902 \u092a\u094d\u0932\u0947 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0915\u0940 \u0917\u0908 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902 \u0914\u0930 \u092a\u094d\u0932\u0947 \u0915\u0930\u0947\u0902\u0964",enable:"\u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902",not_now:"\u0905\u092d\u0940 \u0928\u0939\u0940\u0902",enable_location_to_discover_nearby_skilling_centers_and_more_opportunities_tailored_just_for_you:"\u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0928\u093f\u0915\u091f\u0935\u0930\u094d\u0924\u0940 \u0915\u094c\u0936\u0932 \u0915\u0947\u0902\u0926\u094d\u0930\u094b\u0902 \u0915\u0940 \u0916\u094b\u091c \u0914\u0930 \u0905\u0927\u093f\u0915 \u0905\u0935\u0938\u0930\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u0925\u093e\u0928 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902!",which_program_do_you_want_to_enroll_to:"\u0906\u092a \u0915\u093f\u0938 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e \u092e\u0947\u0902 \u0928\u093e\u092e\u093e\u0902\u0915\u0928 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?",phone_number:"\u092b\u094b\u0928 \u0928\u0902\u092c\u0930",phone_des:"\u092f\u0939 \u0939\u092e\u0947\u0902 \u091c\u0941\u0921\u093c\u0947 \u0930\u0939\u0928\u0947 \u