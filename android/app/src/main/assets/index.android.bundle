c3e\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c40 \u0c35\u0c2f\u0c38\u0c4d\u0c38\u0c41\u0c28\u0c41 \u0c24\u0c46\u0c32\u0c3f\u0c2f\u0c1c\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c2e\u0c40 \u0c38\u0c4d\u0c2a\u0c02\u0c26\u0c28 \u0c2e\u0c3e\u0c15\u0c41 \u0c38\u0c30\u0c48\u0c28 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c37\u0c30\u0c24\u0c41\u0c32\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c21\u0c02\u0c32\u0c4b \u0c38\u0c39\u0c3e\u0c2f\u0c2a\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",I_am_18_or_older:"\u0c28\u0c47\u0c28\u0c41 18 \u0c32\u0c47\u0c26\u0c3e \u0c05\u0c02\u0c24\u0c15\u0c02\u0c1f\u0c47 \u0c0e\u0c15\u0c4d\u0c15\u0c41\u0c35 \u0c35\u0c2f\u0c38\u0c4d\u0c38\u0c41 \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41",I_am_under_18:"\u0c28\u0c47\u0c28\u0c41 18 \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c3e\u0c32 \u0c15\u0c02\u0c1f\u0c47 \u0c24\u0c15\u0c4d\u0c15\u0c41\u0c35","T&C":"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26\u0c3f \u0c17\u0c4b\u0c2a\u0c4d\u0c2f\u0c24\u0c3e \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c1a\u0c3f\u0c35\u0c30\u0c3f \u0c35\u0c30\u0c15\u0c41 \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c4b\u0c32\u0c4d \u0c1a\u0c47\u0c38\u0c3f \u0c1a\u0c26\u0c35\u0c02\u0c21\u0c3f, \u0c24\u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2e\u0c40\u0c30\u0c41 \u0c2c\u0c1f\u0c28\u0c4d\u200c\u0c28\u0c41 \u0c38\u0c15\u0c4d\u0c30\u0c3f\u0c2f\u0c02 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41",create_account:"\u0c16\u0c3e\u0c24\u0c3e \u0c38\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c02\u0c1a\u0c41",button:"\u0c2c\u0c1f\u0c28\u0c4d","T&C_1":"\u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c0e\u0c21\u0c4d\u0c2f\u0c41\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c2b\u0c4c\u0c02\u0c21\u0c47\u0c37\u0c28\u0c4d (\u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d) \u0c2d\u0c3e\u0c30\u0c24\u0c26\u0c47\u0c36\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c05\u0c24\u0c3f\u0c2a\u0c46\u0c26\u0c4d\u0c26 \u0c0e\u0c28\u0c4d\u0c1c\u0c40\u0c35\u0c4b\u0c32\u0c32\u0c4b \u0c12\u0c15\u0c1f\u0c3f, \u0c26\u0c40\u0c28\u0c3f \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d\u0c21\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c3e\u0c32\u0c2f\u0c02 \u0c2e\u0c41\u0c02\u0c2c\u0c48\u0c32\u0c4b \u0c09\u0c02\u0c26\u0c3f. \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d 25 \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c3e\u0c32\u0c15\u0c41 \u0c2a\u0c48\u0c17\u0c3e \u0c35\u0c3f\u0c26\u0c4d\u0c2f\u0c3e \u0c30\u0c02\u0c17\u0c02\u0c32\u0c4b \u0c2a\u0c28\u0c3f\u0c1a\u0c47\u0c38\u0c3f\u0c02\u0c26\u0c3f.","T&C_2":"\u0c2e\u0c40\u0c15\u0c41 \u0c24\u0c46\u0c32\u0c3f\u0c38\u0c3f\u0c28\u0c1f\u0c4d\u0c32\u0c41\u0c17\u0c3e, \u0c2e\u0c40\u0c30\u0c41 \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c47 \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c15\u0c32\u0c3e\u0c2a\u0c3e\u0c32\u0c32\u0c4b \u0c2a\u0c3e\u0c32\u0c4d\u0c17\u0c4a\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c30\u0c41. \u0c08 \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c2d\u0c02\u0c32\u0c4b, \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c24\u0c28 \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c38\u0c47\u0c35\u0c15\u0c41\u0c32\u0c41/\u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c28\u0c3f\u0c27\u0c41\u0c32 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2e\u0c40 \u0c21\u0c47\u0c1f\u0c3e\u0c28\u0c41 \u0c38\u0c47\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f, \u0c07\u0c02\u0c26\u0c41\u0c32\u0c4b \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c15\u0c32\u0c3e\u0c2a\u0c3e\u0c32\u0c32\u0c4b \u0c2a\u0c3e\u0c32\u0c4d\u0c17\u0c4a\u0c28\u0c47\u0c1f\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c2e\u0c42\u0c32 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41, \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c02, \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c2a\u0c41 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02, \u0c05\u0c2d\u0c4d\u0c2f\u0c3e\u0c38 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c21\u0c47\u0c1f\u0c3e, \u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c41/\u0c2b\u0c4b\u0c1f\u0c4b\u0c32\u0c41, \u0c35\u0c40\u0c21\u0c3f\u0c2f\u0c4b\u0c32\u0c41, \u0c35\u0c3e\u0c2f\u0c3f\u0c38\u0c4d \u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c41 ('\u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d\u0c38\u0c4d') \u0c09\u0c02\u0c1f\u0c3e\u0c2f\u0c3f, \u0c15\u0c3e\u0c28\u0c40 \u0c07\u0c35\u0c3f \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c15\u0c3e\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c07\u0c24\u0c30\u0c3e\u0c32\u0c41 \u0c15\u0c42\u0c21\u0c3e \u0c09\u0c02\u0c21\u0c35\u0c1a\u0c4d\u0c1a\u0c41.","T&C_3":"\u0c38\u0c47\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02/\u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d\u0c38\u0c4d \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26\u0c3f \u0c2a\u0c4d\u0c30\u0c2f\u0c4b\u0c1c\u0c28\u0c3e\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c2a\u0c3e\u0c15\u0c4d\u0c37\u0c3f\u0c15\u0c02\u0c17\u0c3e \u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f\u0c17\u0c3e \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f:","T&C_4":"1. \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c15\u0c4d\u0c30\u0c2e \u0c05\u0c2e\u0c32\u0c41 & \u0c2e\u0c46\u0c30\u0c41\u0c17\u0c41\u0c26\u0c32, \u0c38\u0c2e\u0c3e\u0c1c \u0c2d\u0c3e\u0c17\u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c4d\u0c2f\u0c02, \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c30\u0c3f\u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c2a\u0c4d\u0c30\u0c2f\u0c4b\u0c1c\u0c28\u0c3e\u0c32\u0c41.","T&C_5":"2. \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c2a\u0c4d\u0c30\u0c1a\u0c41\u0c30\u0c23\u0c32\u0c32\u0c4b, \u0c26\u0c3e\u0c24\u0c32 \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c15\u0c32\u0c32\u0c4b (\u0c2d\u0c3e\u0c30\u0c24\u0c26\u0c47\u0c36\u0c02\u0c32\u0c4b \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c02\u0c24\u0c30\u0c4d\u0c1c\u0c3e\u0c24\u0c40\u0c2f\u0c02\u0c17\u0c3e), \u0c2e\u0c40\u0c21\u0c3f\u0c2f\u0c3e \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c15\u0c32\u0c3e\u0c2a\u0c3e\u0c32\u0c32\u0c4b, \u0c38\u0c4b\u0c37\u0c32\u0c4d \u0c2e\u0c40\u0c21\u0c3f\u0c2f\u0c3e \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c15\u0c32\u0c3e\u0c2a\u0c3e\u0c32\u0c32\u0c4b (\u0c09\u0c26\u0c3e.: \u0c2b\u0c47\u0c38\u0c4d\u200c\u0c2c\u0c41\u0c15\u0c4d, \u0c2f\u0c42\u0c1f\u0c4d\u0c2f\u0c42\u0c2c\u0c4d, \u0c07\u0c28\u0c4d\u200c\u0c38\u0c4d\u0c1f\u0c3e\u0c17\u0c4d\u0c30\u0c3e\u0c2e\u0c4d, \u0c32\u0c3f\u0c02\u0c15\u0c4d\u0c21\u0c4d\u0c07\u0c28\u0c4d, \u0c1f\u0c4d\u0c35\u0c3f\u0c1f\u0c4d\u0c1f\u0c30\u0c4d, \u0c25\u0c4d\u0c30\u0c46\u0c21\u0c4d\u0c38\u0c4d \u0c2e\u0c4a\u0c26\u0c32\u0c48\u0c28\u0c35\u0c3f), \u0c21\u0c3f\u0c1c\u0c3f\u0c1f\u0c32\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u200c\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u200c\u0c32\u0c32\u0c4b \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c15\u0c32\u0c3e\u0c2a\u0c3e\u0c32\u0c41 (\u0c09\u0c26\u0c3e.: \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c35\u0c46\u0c2c\u0c4d\u200c\u0c38\u0c48\u0c1f\u0c4d\u200c\u0c32\u0c41). \u0c07\u0c35\u0c3f \u0c35\u0c3f\u0c26\u0c4d\u0c2f\u0c3e \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c15\u0c32\u0c3e\u0c2a\u0c3e\u0c32 \u0c17\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c3f \u0c05\u0c35\u0c17\u0c3e\u0c39\u0c28 \u0c15\u0c32\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f.","T&C_6":"3. \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c26\u0c3e\u0c24\u0c43\u0c24\u0c4d\u0c35 \u0c2a\u0c28\u0c3f \u0c17\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c3f \u0c05\u0c35\u0c17\u0c3e\u0c39\u0c28 \u0c15\u0c32\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c26\u0c3e\u0c24\u0c32\u0c24\u0c4b (\u0c2d\u0c3e\u0c30\u0c24\u0c26\u0c47\u0c36\u0c02\u0c32\u0c4b \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c02\u0c24\u0c30\u0c4d\u0c1c\u0c3e\u0c24\u0c40\u0c2f\u0c02\u0c17\u0c3e) \u0c2a\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c02.","T&C_7":"\u0c2a\u0c48\u0c28 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c4d\u0c28 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02/\u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d\u0c38\u0c4d \u0c38\u0c47\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c28\u0c3f\u0c32\u0c4d\u0c35 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c40 \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f\u0c28\u0c3f \u0c07\u0c35\u0c4d\u0c35\u0c2e\u0c28\u0c3f \u0c2e\u0c3f\u0c2e\u0c4d\u0c2e\u0c32\u0c4d\u0c28\u0c3f \u0c15\u0c4b\u0c30\u0c41\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c2e\u0c41. \u0c05\u0c2f\u0c3f\u0c24\u0c47, \u0c2e\u0c40 \u0c35\u0c3f\u0c1a\u0c15\u0c4d\u0c37\u0c23 \u0c2a\u0c4d\u0c30\u0c15\u0c3e\u0c30\u0c02, \u0c2e\u0c40 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02/\u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d\u0c38\u0c4d \u0c38\u0c47\u0c15\u0c30\u0c23\u0c15\u0c41 \u0c2e\u0c40 \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f\u0c28\u0c3f \u0c24\u0c3f\u0c30\u0c38\u0c4d\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.","T&C_8":"\u0c28\u0c47\u0c28\u0c41 \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d, \u0c26\u0c3e\u0c28\u0c3f \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c38\u0c47\u0c35\u0c15\u0c41\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41/\u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c28\u0c3f\u0c27\u0c41\u0c32\u0c15\u0c41 \u0c0e\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c2c\u0c32\u0c35\u0c02\u0c24\u0c02 \u0c32\u0c47\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c28\u0c3e\u0c15\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c2a\u0c48\u0c28 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c4d\u0c28 \u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d\u0c38\u0c4d\u200c\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c28\u0c3f\u0c32\u0c4d\u0c35 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c2a\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c2a\u0c4d\u0c30\u0c1a\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f\u0c28\u0c3f \u0c07\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41.","T&C_9":"\u0c0f \u0c38\u0c2e\u0c2f\u0c02\u0c32\u0c4b\u0c28\u0c48\u0c28\u0c3e \u0c28\u0c3e \u0c21\u0c47\u0c1f\u0c3e/\u0c2b\u0c4b\u0c1f\u0c4b/\u0c35\u0c40\u0c21\u0c3f\u0c2f\u0c4b\u0c28\u0c41 \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c35\u0c46\u0c2c\u0c4d\u200c\u0c38\u0c48\u0c1f\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c3f\u0c32\u0c4d\u0c35 \u0c35\u0c47\u0c26\u0c3f\u0c15\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c3f, \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c38\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c3f \u0c28\u0c47\u0c28\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c23\u0c2f\u0c3f\u0c02\u0c1a\u0c3f\u0c28\u0c1f\u0c4d\u0c32\u0c2f\u0c3f\u0c24\u0c47, \u0c28\u0c47\u0c28\u0c41 \u0c2b\u0c4b\u0c28\u0c4d/\u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c38\u0c47\u0c35\u0c15\u0c41\u0c21\u0c41/\u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c28\u0c3f\u0c27\u0c3f\u0c28\u0c3f \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c28\u0c41, \u0c26\u0c3e\u0c28\u0c3f \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c35\u0c4d\u0c30\u0c3e\u0c24\u0c2a\u0c42\u0c30\u0c4d\u0c35\u0c15 \u0c09\u0c2a\u0c38\u0c02\u0c39\u0c30\u0c23/\u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c1c\u0c30\u0c17\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c06 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24, \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d, \u0c26\u0c3e\u0c28\u0c3f \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c38\u0c47\u0c35\u0c15\u0c41\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41/\u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c28\u0c3f\u0c27\u0c41\u0c32\u0c41 15 \u0c2a\u0c28\u0c3f \u0c30\u0c4b\u0c1c\u0c41\u0c32\u0c32\u0c4b\u0c2a\u0c41 \u0c26\u0c3e\u0c28\u0c3f\u0c28\u0c3f \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c30\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c38\u0c35\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c30\u0c41/\u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c30\u0c41. \u0c08 \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c2d\u0c02\u0c32\u0c4b, \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c2a\u0c41 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26 \u0c07\u0c35\u0c4d\u0c35\u0c2c\u0c21\u0c4d\u0c21\u0c3e\u0c2f\u0c3f.","T&C_10":"\u0c28\u0c47\u0c28\u0c41 \u0c2a\u0c48\u0c28 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c4d\u0c28 \u0c35\u0c3f\u0c37\u0c2f\u0c3e\u0c32\u0c28\u0c41 \u0c1a\u0c26\u0c3f\u0c35\u0c3e\u0c28\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41/\u0c32\u0c47\u0c26\u0c3e \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c3f\u0c15 \u0c2d\u0c3e\u0c37\u0c32\u0c4b \u0c35\u0c3f\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c4d\u0c21\u0c3e\u0c28\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c35\u0c3f\u0c37\u0c2f\u0c3e\u0c32\u0c28\u0c41 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f\u0c17\u0c3e \u0c05\u0c30\u0c4d\u0c25\u0c02 \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41. \u0c28\u0c47\u0c28\u0c41 \u0c28\u0c3e \u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d\u0c38\u0c4d/\u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c2a\u0c48\u0c28 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c4d\u0c28 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c15\u0c41 \u0c28\u0c3e \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f\u0c28\u0c3f \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c02 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f \u0c0e\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c28\u0c41.","T&C_11":"\u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c2a\u0c41 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41: \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c0e\u0c21\u0c4d\u0c2f\u0c41\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c2b\u0c4c\u0c02\u0c21\u0c47\u0c37\u0c28\u0c4d",office_adrress:"\u0c22\u0c3f\u0c32\u0c4d\u0c32\u0c40 \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c3e\u0c32\u0c2f\u0c02: B4/59, \u0c38\u0c2b\u0c4d\u0c26\u0c30\u0c4d\u200c\u0c1c\u0c02\u0c17\u0c4d \u0c0e\u0c28\u0c4d\u200c\u0c15\u0c4d\u0c32\u0c47\u0c35\u0c4d, \u0c28\u0c4d\u0c2f\u0c42 \u0c22\u0c3f\u0c32\u0c4d\u0c32\u0c40-110029",office_email:"\u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d: dataprotectionofficer@pratham.org",office_phone:"\u0c2b\u0c4b\u0c28\u0c4d \u0c28\u0c02: 011-26177200",office_website:"| www.pratham.org |",office_cin:"CIN: U80101MH2002NPL136300","T&C_12":"\u0c28\u0c47\u0c28\u0c41 \u0c17\u0c4b\u0c2a\u0c4d\u0c2f\u0c24\u0c3e \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c1a\u0c26\u0c3f\u0c35\u0c3e\u0c28\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f \u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u200c\u0c32\u0c4b \u0c35\u0c3f\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c35\u0c3f\u0c27\u0c02\u0c17\u0c3e \u0c28\u0c3e \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24 \u0c21\u0c47\u0c1f\u0c3e \u0c38\u0c47\u0c15\u0c30\u0c23 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41.","T&C_13":"\u0c2e\u0c40\u0c30\u0c41 \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \u0c2a\u0c47\u0c1c\u0c40\u0c32\u0c4b\u0c28\u0c3f '\u0c21\u0c47\u0c1f\u0c3e & \u0c17\u0c4b\u0c2a\u0c4d\u0c2f\u0c24\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c02'\u0c32\u0c4b \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c2a\u0c41 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c0e\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c48\u0c28\u0c3e \u0c21\u0c47\u0c1f\u0c3e \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c2a\u0c41, \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c32\u0c47\u0c26\u0c3e \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",username_already_exists:"\u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c2a\u0c47\u0c30\u0c41 \u0c07\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c47 \u0c09\u0c02\u0c26\u0c3f",username_is_already_exists_in_keycloak:"Keycloak \u0c32\u0c4b \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c2a\u0c47\u0c30\u0c41 \u0c07\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c47 \u0c09\u0c02\u0c26\u0c3f.",something_went_wrong_try_again_later:"\u0c0f\u0c26\u0c4b \u0c24\u0c2a\u0c4d\u0c2a\u0c41 \u0c1c\u0c30\u0c3f\u0c17\u0c3f\u0c02\u0c26\u0c3f, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",Learning_Content:"\u0c05\u0c2d\u0c4d\u0c2f\u0c3e\u0c38 \u0c15\u0c02\u0c1f\u0c46\u0c02\u0c1f\u0c4d",Update_your_preferences_to_get_the_best_picks_just_for_you:"\u0c2e\u0c40 \u0c15\u0c4b\u0c38\u0c02 \u0c09\u0c24\u0c4d\u0c24\u0c2e \u0c0e\u0c02\u0c2a\u0c3f\u0c15\u0c32\u0c28\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c40 \u0c2a\u0c4d\u0c30\u0c3e\u0c27\u0c3e\u0c28\u0c4d\u0c2f\u0c24\u0c32\u0c28\u0c41 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f!",Based_on_Your_Interests:"\u0c2e\u0c40 \u0c06\u0c38\u0c15\u0c4d\u0c24\u0c41\u0c32 \u0c06\u0c27\u0c3e\u0c30\u0c02\u0c17\u0c3e",view_all:"\u0c05\u0c28\u0c4d\u0c28\u0c40 \u0c35\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",Financial_Literacy:"\u0c06\u0c30\u0c4d\u0c25\u0c3f\u0c15 \u0c38\u0c3e\u0c15\u0c4d\u0c37\u0c30\u0c24",Continue_Learning:"\u0c2a\u0c20\u0c28 \u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",Preferences:"\u0c05\u0c2d\u0c3f\u0c30\u0c41\u0c1a\u0c41\u0c32\u0c41",Food_Production:"\u0c06\u0c39\u0c3e\u0c30 \u0c09\u0c24\u0c4d\u0c2a\u0c24\u0c4d\u0c24\u0c3f",Conceptual_Thinking:"\u0c38\u0c02\u0c15\u0c32\u0c28\u0c02 \u0c06\u0c32\u0c4b\u0c1a\u0c28",Todays_Top_Pick:"\u0c08 \u0c30\u0c4b\u0c1c\u0c41 \u0c1f\u0c3e\u0c2a\u0c4d \u0c2a\u0c3f\u0c15\u0c4d",Art:"\u0c15\u0c33",Assessments:"\u0c2e\u0c42\u0c32\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c28\u0c3e\u0c32\u0c41",assessment:"\u0c2e\u0c42\u0c32\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c28\u0c02","pre-test":"\u0c2a\u0c4d\u0c30\u0c40 \u0c1f\u0c46\u0c38\u0c4d\u0c1f\u0c4d","post-test":"\u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d \u0c1f\u0c46\u0c38\u0c4d\u0c1f\u0c4d",Inprogress:"\u0c1c\u0c30\u0c41\u0c17\u0c41\u0c24\u0c4b\u0c02\u0c26\u0c3f",Overallscore:"\u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u0c38\u0c4d\u0c15\u0c4b\u0c30\u0c4d:",completed:"\u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c2f\u0c3f\u0c02\u0c26\u0c3f",take_the_test:"\u0c2a\u0c30\u0c40\u0c15\u0c4d\u0c37\u0c28\u0c41 \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",not_started:"\u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c32\u0c47\u0c26\u0c41",submitted_On:"\u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f :",reading:"\u0c2a\u0c20\u0c28\u0c02",out_of:"\u0c28\u0c41\u0c02\u0c21\u0c3f",correct_answers:"\u0c38\u0c30\u0c48\u0c28 \u0c38\u0c2e\u0c3e\u0c27\u0c3e\u0c28\u0c3e\u0c32\u0c41",assessment_note:"\u0c17\u0c2e\u0c28\u0c3f\u0c15: \u0c2e\u0c40 \u0c2a\u0c4d\u0c30\u0c40-\u0c1f\u0c46\u0c38\u0c4d\u0c1f\u0c4d \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c23 \u0c15\u0c47\u0c35\u0c32\u0c02 \u0c2e\u0c40\u0c30\u0c41 \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c35\u0c3f\u0c2d\u0c3e\u0c17\u0c3e\u0c32\u0c28\u0c41 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f\u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c47 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c2a\u0c30\u0c3f\u0c17\u0c23\u0c28\u0c32\u0c4b\u0c15\u0c3f \u0c24\u0c40\u0c38\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c3e\u0c30\u0c41.",assessment_instructions:"\u0c15\u0c3f\u0c02\u0c26 \u0c09\u0c28\u0c4d\u0c28 \u0c2a\u0c4d\u0c30\u0c24\u0c3f \u0c38\u0c2c\u0c4d\u0c1c\u0c46\u0c15\u0c4d\u0c1f\u0c41\u0c15\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c2a\u0c30\u0c40\u0c15\u0c4d\u0c37\u0c32\u0c28\u0c41 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c2e\u0c40\u0c30\u0c41 \u0c35\u0c3e\u0c1f\u0c3f\u0c28\u0c3f \u0c0f \u0c15\u0c4d\u0c30\u0c2e\u0c02\u0c32\u0c4b\u0c28\u0c48\u0c28\u0c3e \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",instruction1:"\u0c15\u0c3e\u0c32\u0c2a\u0c30\u0c3f\u0c2e\u0c3f\u0c24\u0c3f: \u0c2a\u0c30\u0c40\u0c15\u0c4d\u0c37 \u0c38\u0c30\u0c3f\u0c17\u0c4d\u0c17\u0c3e \u0c38\u0c2e\u0c2f\u0c02 \u0c06\u0c27\u0c3e\u0c30\u0c3f\u0c24\u0c02\u0c17\u0c3e \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c07\u0c26\u0c3f 20 \u0c28\u0c3f\u0c2e\u0c3f\u0c37\u0c3e\u0c32\u0c41 \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c38\u0c2e\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c15\u0c4d\u0c30\u0c2e\u0c2c\u0c26\u0c4d\u0c27\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",instruction2:"\u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32 \u0c38\u0c02\u0c16\u0c4d\u0c2f: \u0c2a\u0c30\u0c40\u0c15\u0c4d\u0c37\u0c32\u0c4b \u0c2c\u0c39\u0c41\u0c33 \u0c0e\u0c02\u0c2a\u0c3f\u0c15 \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32\u0c41 \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3f. \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f \u0c2e\u0c40\u0c30\u0c41 \u0c38\u0c2e\u0c2f\u0c2a\u0c30\u0c3f\u0c2e\u0c3f\u0c24\u0c3f\u0c32\u0c4b \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32\u0c15\u0c41 \u0c38\u0c2e\u0c3e\u0c27\u0c3e\u0c28\u0c02 \u0c07\u0c35\u0c4d\u0c35\u0c02\u0c21\u0c3f.",instruction3:"\u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c23: \u0c2e\u0c40\u0c30\u0c41 \u0c2a\u0c30\u0c40\u0c15\u0c4d\u0c37\u0c28\u0c41 \u0c12\u0c15\u0c4d\u0c15\u0c38\u0c3e\u0c30\u0c47 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c23 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c2e\u0c40 \u0c38\u0c2e\u0c3e\u0c27\u0c3e\u0c28\u0c3e\u0c32\u0c28\u0c41 \u0c1c\u0c3e\u0c17\u0c4d\u0c30\u0c24\u0c4d\u0c24\u0c17\u0c3e \u0c38\u0c2e\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f, \u0c0e\u0c02\u0c26\u0c41\u0c15\u0c02\u0c1f\u0c47 \u0c2e\u0c40\u0c15\u0c41 \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c35\u0c15\u0c3e\u0c36\u0c02 \u0c09\u0c02\u0c21\u0c26\u0c41.",instruction4:"\u0c2a\u0c30\u0c40\u0c15\u0c4d\u0c37 \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c21\u0c02: \u0c2e\u0c40\u0c30\u0c41 \u0c38\u0c02\u0c26\u0c3f\u0c17\u0c4d\u0c27\u0c24 \u0c32\u0c47\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c2a\u0c4d\u0c30\u0c36\u0c3e\u0c02\u0c24\u0c2e\u0c48\u0c28 \u0c35\u0c3e\u0c24\u0c3e\u0c35\u0c30\u0c23\u0c02\u0c32\u0c4b \u0c09\u0c02\u0c21\u0c47\u0c32\u0c3e \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f. \u0c2e\u0c40 \u0c07\u0c02\u0c1f\u0c30\u0c4d\u0c28\u0c46\u0c1f\u0c4d \u0c15\u0c28\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d \u0c38\u0c4d\u0c25\u0c3f\u0c30\u0c02\u0c17\u0c3e \u0c09\u0c02\u0c26\u0c28\u0c3f \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.",instruction5:"\u0c2a\u0c30\u0c40\u0c15\u0c4d\u0c37\u0c32\u0c4b \u0c28\u0c3e\u0c35\u0c3f\u0c17\u0c47\u0c1f\u0c3f\u0c02\u0c17\u0c4d: \u0c2a\u0c4d\u0c30\u0c24\u0c3f \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c28\u0c41 \u0c1c\u0c3e\u0c17\u0c4d\u0c30\u0c24\u0c4d\u0c24\u0c17\u0c3e \u0c1a\u0c26\u0c35\u0c02\u0c21\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c2e\u0c3e\u0c27\u0c3e\u0c28\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f. \u0c2e\u0c40\u0c30\u0c41 \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32\u0c28\u0c41 \u0c26\u0c3e\u0c1f\u0c35\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c3e\u0c1f\u0c3f\u0c28\u0c3f \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c1a\u0c42\u0c21\u0c35\u0c1a\u0c4d\u0c1a\u0c41, \u0c15\u0c3e\u0c28\u0c40 \u0c1f\u0c48\u0c2e\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c2a\u0c30\u0c4d\u0c2f\u0c35\u0c47\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f. \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32 \u0c2e\u0c27\u0c4d\u0c2f \u0c2e\u0c3e\u0c30\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f 'Next' \u0c2e\u0c30\u0c3f\u0c2f\u0c41 'Previous' \u0c2c\u0c1f\u0c28\u0c4d\u200c\u0c32\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.","Read_T_&_C":"\u0c28\u0c47\u0c28\u0c41 \u0c1a\u0c26\u0c3f\u0c35\u0c3e\u0c28\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41",terms_and_conditions2:"\u0c17\u0c4b\u0c2a\u0c4d\u0c2f\u0c24\u0c3e \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c3e\u0c32\u0c41",no_data_found:"\u0c21\u0c47\u0c1f\u0c3e \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c2c\u0c21\u0c32\u0c47\u0c26\u0c41",my_profile:"\u0c28\u0c3e \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d",second_chance_program:"\u0c38\u0c46\u0c15\u0c02\u0c21\u0c4d \u0c1b\u0c3e\u0c28\u0c4d\u0c38\u0c4d \u0c2a\u0c4d\u0c30\u0c4b\u0c17\u0c4d\u0c30\u0c3e\u0c2e\u0c4d",pathways:"\u0c2e\u0c3e\u0c30\u0c4d\u0c17\u0c3e\u0c32\u0c41",logout:"\u0c32\u0c3e\u0c17\u0c4d \u0c05\u0c35\u0c41\u0c1f\u0c4d",general_instructions:"\u0c38\u0c3e\u0c27\u0c3e\u0c30\u0c23 \u0c38\u0c42\u0c1a\u0c28\u0c32\u0c41",test_medium:"\u0c2a\u0c30\u0c40\u0c15\u0c4d\u0c37 \u0c2e\u0c3e\u0c27\u0c4d\u0c2f\u0c2e\u0c02",board:"\u0c2c\u0c4b\u0c30\u0c4d\u0c21\u0c41",start_test:"\u0c2a\u0c30\u0c40\u0c15\u0c4d\u0c37 \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",block:"\u0c2c\u0c4d\u0c32\u0c3e\u0c15\u0c4d",unit:"\u0c2f\u0c42\u0c28\u0c3f\u0c1f\u0c4d",enrollment_id:"\u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c10\u0c21\u0c3f",contact_number:"\u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c2a\u0c41 \u0c38\u0c02\u0c16\u0c4d\u0c2f",class:"\u0c24\u0c30\u0c17\u0c24\u0c3f",last_passed_grade:"\u0c1a\u0c3f\u0c35\u0c30\u0c17\u0c3e \u0c09\u0c24\u0c4d\u0c24\u0c40\u0c30\u0c4d\u0c23\u0c2e\u0c48\u0c28 \u0c17\u0c4d\u0c30\u0c47\u0c21\u0c4d",age:"\u0c35\u0c2f\u0c38\u0c4d\u0c38\u0c41",en:"\u0c07\u0c02",hi:"\u0c39\u0c3f\u0c02",ma:"\u0c2e",ba:"\u0c2c\u0c46\u0c02",te:"\u0c24\u0c46.",ka:"\u0c15.",ta:"\u0c24",gu:"\u0c17\u0c41",ur:"\u0c09\u0c30\u0c4d\u0c26\u0c42",invalid_username_or_password:"\u0c05\u0c38\u0c3e\u0c27\u0c41 \u0c2f\u0c42\u0c1c\u0c30\u0c4d\u200c\u0c28\u0c47\u0c2e\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d",network_error_try_again_later:"\u0c28\u0c46\u0c1f\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c15\u0c4d \u0c32\u0c4b\u0c2a\u0c02, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",log_in:"\u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",login_with_the_cred:"\u0c2e\u0c40\u0c15\u0c41 \u0c07\u0c1a\u0c4d\u0c1a\u0c3f\u0c28 \u0c15\u0c4d\u0c30\u0c46\u0c21\u0c46\u0c28\u0c4d\u0c37\u0c3f\u0c2f\u0c32\u0c4d\u0c38\u0c4d\u200c\u0c24\u0c4b \u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",total_marks:"\u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u0c2e\u0c3e\u0c30\u0c4d\u0c15\u0c41\u0c32\u0c41",full_name:"\u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c2a\u0c47\u0c30\u0c41",state:"\u0c30\u0c3e\u0c37\u0c4d\u0c1f\u0c4d\u0c30\u0c02",district:"\u0c1c\u0c3f\u0c32\u0c4d\u0c32\u0c3e",unanswered:"\u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32\u0c15\u0c41 \u0c38\u0c2e\u0c3e\u0c27\u0c3e\u0c